# Build output (regenerated by dotnet build / dotnet run)
bin/
obj/
publish/

# Runtime files from isa-run.ps1 / start-isa.bat
*.log
isa.pid

# Old backup copies of files
*.bak
*.bak2
# Dated backups too, like data/notebook.db.bak-2026-10-23
*.bak-*

# Visual Studio local settings
.vs/

# Local databases (rebuilt by content/build_content_db.py / created at runtime)
data/*.db
# Except the onboarding content (journey steps, sample contacts, key dates, handoff
# checklist, "worth saving?" tags), built by onboarding/build_onboarding_db.py. It holds
# no one's progress or notes, so it is shared: a merge gives everyone the same version.
!data/onboarding.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/stale-*.old

# Loose stray folders at the repo root
/IsaChatApp/
/Web/

# Real API keys and secrets. Copy dev-keys.example.json to dev-keys.json, or enter them on the Dev Dashboard (Models, RAG, access & ticketing).
dev-keys.json

# Zip made to send the Keycloak folder to a teammate
keycloak.zip

# Isa's spoken Library audio (made on first play, or by the pre-make step at start)
data/tts-cache/
