    // notebook icon in the header. NotebookService decides who may open it.
    private bool IsNotebookOpen { get; set; } = false;
    private void ToggleNotebook() { IsNotebookOpen = !IsNotebookOpen; if (!IsNotebookOpen) Unenlarge(SidePanel.Notebook); }
    private void OpenNotebook() => IsNotebookOpen = true;
    private void CloseNotebook() { IsNotebookOpen = false; Unenlarge(SidePanel.Notebook); }

    // Goes up by one whenever something is saved to the notebook from the
    // chat, so an open notebook panel reads its entries again.
    private int _notebookVersion;
    private void NotebookChanged() => _notebookVersion++;

