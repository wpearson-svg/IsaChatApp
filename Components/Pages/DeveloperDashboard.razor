@page "/dev-dashboard"

@* ============================================================
   DeveloperDashboard.razor

   The team's dashboard, linked from the chat widget's header (the ">_" icon). Needs the dashboard_dev role.
   Every control on it is real:
   - Compliance policy: the four answer-quality numbers are saved by OutputComplianceSettings and read on every
     question; the rules list and the output-checks list are read from the live rules files and settings; the
     change log is the real record of saves (SettingsChangeLog).
   - Role access: the roles Isa actually checks.
   - Testing console, Translation test, Vector search test, Rule tester, Content import: run the real pipeline,
     services and files.
   - Services: where Keycloak, Ollama, the voice, embeddings and translation run (saved to appsettings.Local.json).
   - Models, RAG, access & ticketing: the Salesforce settings (saved to dev-keys.json).
   - Front end, Health alerts: real counts from usage.db and events.db, and live checks of each service (DevHealthService).

   Dressed in the same ISACA palette as the rest of the app (see WidgetSettings.IsacaColors).
   ============================================================ *@

@using IsaChatApp.Services
@inject WidgetSettings Settings
@inject DevKeysStore DevKeys
@inject OutputComplianceSettings OutputSettings
@inject DevAccessService DevAccess
@inject LocalServiceSettings ServiceSettings
@inject ServicesAtStart StartServices
@inject IHttpClientFactory HttpFactory
@inject IConfiguration Config
@inject SettingsChangeLog ChangeLog
@inject IsaChatApp.Services.Rules.RuleEngine RuleSet
@rendermode InteractiveServer

<PageTitle>Developer Dashboard</PageTitle>

@if (!Settings.CanAccessDevDashboard && !_isDev)
{
    <h1>Access restricted</h1>
    <p class="text-muted">
        The Dev Dashboard isn't available to the <strong>@Settings.CurrentRole</strong>
        role. Only Developer and Executive have access &mdash; switch roles on
        <a href="/isa-config">/isa-config</a> if this should be visible.
    </p>
}
else
{
    <div class="dd">
        <aside class="dd__nav">
            <div class="dd__navHeader">
                <span class="dd__navTitle">Dev Dashboard</span>
                <span class="dd__badge">ADMIN</span>
            </div>
            <nav class="dd__navList">
                @foreach (var section in Sections)
                {
                    <button type="button"
                            class="dd__navItem @(section.Key == ActiveSection ? "is-active" : "")"
                            @onclick="@(() => ActiveSection = section.Key)">
                        @section.Label
                    </button>
                }
            </nav>
        </aside>

        <section class="dd__main">
            @if (ActiveSection == "compliance")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Compliance policy</h1>
                    <div class="dd__topbarActions">
                        <button type="button" class="dd__btn dd__btn--ghost" @onclick="ToggleChangeLog">
                            View change log
                        </button>
                        <button type="button" class="dd__btn dd__btn--primary" @onclick="SaveChanges">
                            Save changes
                        </button>
                    </div>
                </div>

                @if (_savedMessageVisible)
                {
                    <div class="dd__toast">
                        @_saveMessage
                    </div>
                }

                @if (_changeLogVisible)
                {
                    <div class="dd__changelog">
                        <strong>Change log</strong>
                        @if (_changes.Count == 0)
                        {
                            <p class="dd__tableHint">No changes recorded yet. Every save or reset of a setting on this dashboard is written here with who made it, when, and the old and new value.</p>
                        }
                        else
                        {
                            <table class="dd__table">
                                <thead><tr><th>When</th><th>Who</th><th>Setting</th><th>Was</th><th>Now</th></tr></thead>
                                <tbody>
                                    @foreach (var c in _changes)
                                    {
                                        <tr>
                                            <td>@c.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@c.Who</td>
                                            <td>@c.Area: @c.Setting</td>
                                            <td>@(c.Old ?? "")</td>
                                            <td>@(c.New ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <p class="dd__tableHint">The last @_changes.Count changes, newest first. Kept in <code>@SettingsChangeLog.FileName</code> in the project folder (this computer only, not in Git). Secret values are never written.</p>
                        }
                    </div>
                }

                <div class="dd__grid">
                    <div class="dd__card">
                        <div class="dd__cardHeader">
                            <h3>Answer confidence threshold</h3>
                            <span class="dd__tag dd__tag--green">OUTPUT COMPLIANCE</span>
                        </div>
                        <p class="dd__cardHint">
                            An AI answer's confidence (the search strength averaged with the share
                            of its sentences the passage supports) below this level counts as a failed check. See the
                            strong-match mark for what happens next.
                        </p>
                        <input type="range" class="dd__slider" min="0" max="100" step="1"
                               value="@ConfidenceThreshold"
                               @oninput="OnConfidenceChanged" />
                        <div class="dd__sliderLabels">
                            <span>More answers</span>
                            <span class="dd__sliderValue">@ConfidenceThreshold%</span>
                            <span>More handoffs</span>
                        </div>
                    </div>

                    <div class="dd__card">
                        <div class="dd__cardHeader">
                            <h3>Answer-support (NLI) pass mark</h3>
                            <span class="dd__tag dd__tag--green">OUTPUT COMPLIANCE</span>
                        </div>
                        <p class="dd__cardHint">
                            Each sentence of an AI-written answer is scored against the approved
                            passage it cites. A sentence scoring below this mark fails the check. If most of the
                            answer is supported, the failing sentences are dropped; otherwise Isa shows ISACA's own words or
                            passes the question to a person (see the strong-match mark). Default @OutputSettings.NliDefault.ToString("0.00").
                        </p>
                        <input type="range" class="dd__slider" min="0" max="100" step="1"
                               value="@NliThresholdPct"
                               @oninput="OnNliChanged" />
                        <div class="dd__sliderLabels">
                            <span>Accepts looser answers</span>
                            <span class="dd__sliderValue">@((NliThresholdPct / 100.0).ToString("0.00"))</span>
                            <span>Stricter</span>
                        </div>
                        <p class="dd__tableHint">
                            Applies to the next question after you press Save changes. Direct
                            database answers are ISACA's own words and are not scored.
                        </p>
                        <button type="button" class="dd__btn dd__btn--ghost" @onclick="ResetOutputSettings">
                            Reset to defaults
                        </button>
                    </div>

                    <div class="dd__card">
                        <div class="dd__cardHeader">
                            <h3>Strong-match mark</h3>
                            <span class="dd__tag dd__tag--green">OUTPUT COMPLIANCE</span>
                        </div>
                        <p class="dd__cardHint">
                            When an AI-written answer fails a check, Isa looks at how well the search matched.
                            At or above this mark, she shows ISACA's own words from the passage instead. Below it,
                            the question goes to a person. At 0.00 every match counts as strong, so a failed check
                            never goes to a person. Default @OutputSettings.StrongMatchDefault.ToString("0.00").
                        </p>
                        <input type="range" class="dd__slider" min="0" max="100" step="1"
                               value="@StrongMatchPct"
                               @oninput="OnStrongMatchChanged" />
                        <div class="dd__sliderLabels">
                            <span>More ISACA quotes</span>
                            <span class="dd__sliderValue">@((StrongMatchPct / 100.0).ToString("0.00"))</span>
                            <span>More handoffs</span>
                        </div>
                        <p class="dd__tableHint">
                            Search by meaning scores between the search pass mark and 1.00, so a mark below the
                            search pass mark has the same effect as 0.00.
                        </p>
                    </div>

                    <div class="dd__card">
                        <div class="dd__cardHeader">
                            <h3>Search pass mark</h3>
                            <span class="dd__tag dd__tag--green">SEARCH</span>
                        </div>
                        <p class="dd__cardHint">
                            How close an approved passage must be to the question for search by meaning to use it.
                            Lower: more questions reach the AI. Higher: more questions go to a person as
                            "not covered", and fewer AI calls. Default @OutputSettings.SearchPassMarkDefault.ToString("0.00").
                        </p>
                        <input type="range" class="dd__slider" min="0" max="100" step="1"
                               value="@SearchPassMarkPct"
                               @oninput="OnSearchPassMarkChanged" />
                        <div class="dd__sliderLabels">
                            <span>More AI answers</span>
                            <span class="dd__sliderValue">@((SearchPassMarkPct / 100.0).ToString("0.00"))</span>
                            <span>More handoffs</span>
                        </div>
                        <p class="dd__tableHint">
                            Unrelated text still scores about 0.70 with this embedding model, so marks below 0.75
                            let in passages that don't match. See Testing &gt; Vector search test for real scores.
                        </p>
                    </div>

                    <div class="dd__card dd__card--wide">
                        <div class="dd__cardHeader">
                            <h3>Rules that hand a question to a person or stop it</h3>
                            <span class="dd__tag dd__tag--green">INPUT COMPLIANCE</span>
                        </div>
                        <p class="dd__cardHint">
                            Read from the rules files in <code>rules\</code> (@RuleSet.RuleCount rules in @RuleSet.FileCount files), the same
                            ones the live question check uses. To change what goes to a person, change the rules file; the Rule tester tab
                            shows what each rule does for a chapter and role.
                        </p>
                        <table class="dd__table">
                            <thead><tr><th>Rule</th><th>What it covers</th><th>What happens</th><th>File</th></tr></thead>
                            <tbody>
                                @foreach (var r in HandOffRules)
                                {
                                    <tr>
                                        <td>@r.RuleId</td>
                                        <td>@r.Title</td>
                                        <td>@(r.Outcome == "stop" ? "Stopped (outside scope)" : "Passed to a person")</td>
                                        <td>@r.File</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="dd__card dd__card--wide">
                        <div class="dd__cardHeader">
                            <h3>Output checks, as they run now</h3>
                            <span class="dd__tag dd__tag--green">OUTPUT COMPLIANCE</span>
                        </div>
                        <p class="dd__cardHint">
                            What an AI-written answer goes through before it is shown, in order. Read from the live settings; change the numbers
                            with the sliders above. Direct answers from the database are ISACA's own words and skip most of these.
                        </p>
                        <table class="dd__table">
                            <thead><tr><th>Check</th><th>Now</th><th>What it does</th></tr></thead>
                            <tbody>
                                @foreach (var row in OutputCheckRows)
                                {
                                    <tr><td>@row.Name</td><td>@row.State</td><td>@row.Note</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="dd__card dd__card--wide">
                        <div class="dd__cardHeader">
                            <h3>Testing console</h3>
                            <span class="dd__tag dd__tag--green">ADMIN</span>
                        </div>
                        <p class="dd__cardHint">
                            Questions are tested through the real pipeline (real search, model, rules, checks and tickets) in the Testing console tab,
                            which also has the trace lookup. The Translation test, Vector search test and Rule tester tabs test those parts on their own.
                        </p>
                        <button type="button" class="dd__btn dd__btn--primary" @onclick='@(() => ActiveSection = "testing")'>Open the Testing console</button>
                    </div>
                </div>
            }
            else if (ActiveSection == "roleaccess")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Role access</h1>
                </div>
                <div class="dd__card">
                    <div class="dd__cardHeader">
                        <h3>Who can do what</h3>
                        <span class="dd__tag dd__tag--orange">ACCESS CONTROL</span>
                    </div>
                    <p class="dd__cardHint">The Keycloak roles Isa checks. Accounts and their roles are in Keycloak (the realm is built from <code>directory\keycloak_accounts.csv</code>).</p>
                    <table class="dd__table">
                        <thead><tr><th>Role</th><th>What it allows</th><th>Checked by</th></tr></thead>
                        <tbody>
                            <tr><td>chat_user</td><td>Ask Isa questions. Without it a question is refused (403).</td><td>AccessControlAdapter, on every question</td></tr>
                            <tr><td>dashboard_dev</td><td>The team's Backstage: this dashboard, the Config page, the Testing console and Content import.</td><td>DevAccessService, when each page opens</td></tr>
                        </tbody>
                    </table>
                    <p class="dd__tableHint">
                        Isa has no content tiers: the approved passages carry no audience tag, so every signed-in person with chat_user can be given any of them.
                        What differs by person is the rules, which apply by the chapter and the chapter role from the sign-in profile (see the rules list on Compliance policy).
                    </p>
                </div>
            }
            else if (ActiveSection == "frontend")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Front end</h1>
                </div>
                <DevFrontEnd />
            }
            else if (ActiveSection == "health")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Health alerts</h1>
                </div>
                <DevHealthAlerts />
            }
            else if (ActiveSection == "testing")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Testing console</h1>
                </div>
                <div class="dd__card">
                    @* T5W: runs the real pipeline, always shows dev tags and reasons,
                       has the trace lookup, and needs the dashboard_dev role. *@
                    <DevTesting />
                </div>
            }
            else if (ActiveSection == "translation")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Translation test</h1>
                </div>
                <div class="dd__card">
                    <TranslationTest />
                </div>
            }
            else if (ActiveSection == "vectorsearch")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Vector search test</h1>
                </div>
                <div class="dd__card">
                    <VectorSearchTest />
                </div>
            }
            else if (ActiveSection == "ruletester")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Rule tester</h1>
                </div>
                <div class="dd__card">
                    <RuleTester />
                </div>
            }
            else if (ActiveSection == "content")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Content import</h1>
                </div>
                <div class="dd__card">
                    <ContentImport />
                </div>
            }
            else if (ActiveSection == "models")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Models, RAG, access &amp; ticketing</h1>
                </div>
                <div class="dd__card">
                    <div class="dd__cardHeader">
                        <h3>Ticketing (Salesforce)</h3>
                        <span class="dd__tag dd__tag--purple">TICKETING</span>
                    </div>
                    <p class="dd__cardHint">
                        Saved to <code>dev-keys.json</code> in the project folder, the same file
                        <code>test-salesforce.ps1</code> reads. The secret is never shown again
                        after saving; leave it blank to keep the saved one.
                    </p>
                    <div class="dd__fields">
                        <label class="dd__field">Org address
                            <input type="text" class="dd__testInput" @bind="_sfOrgUrl" autocomplete="off"
                                   placeholder="https://your-org.develop.my.salesforce.com" />
                        </label>
                        <label class="dd__field">API version
                            <input type="text" class="dd__testInput" @bind="_sfApiVersion" autocomplete="off"
                                   placeholder="v68.0" />
                        </label>
                        <label class="dd__field">Consumer key
                            <input type="text" class="dd__testInput" @bind="_sfClientId" autocomplete="off" />
                        </label>
                        <label class="dd__field">Consumer secret
                            <input type="password" class="dd__testInput" @bind="_sfSecret" autocomplete="new-password"
                                   placeholder="@(_sfSecretIsSet ? "Saved. Leave blank to keep" : "Not set")" />
                        </label>
                    </div>
                    <div class="dd__saveRow">
                        <button type="button" class="dd__btn dd__btn--primary" @onclick="SaveSalesforce">Save</button>
                        @if (!string.IsNullOrEmpty(_sfMessage))
                        {
                            <span class="dd__saveNote @(_sfMessageIsError ? "dd__saveNote--err" : "dd__saveNote--ok")">@_sfMessage</span>
                        }
                    </div>
                </div>
            }
            else if (ActiveSection == "services")
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">Services (this computer)</h1>
                </div>
                <div class="dd__grid">
                    <div class="dd__card">
                        <div class="dd__cardHeader">
                            <h3>Where the services run</h3>
                            <span class="dd__tag dd__tag--purple">NEEDS A RESTART</span>
                        </div>
                        <p class="dd__cardHint">
                            Keycloak (sign-in), Ollama (the model), the voice, embeddings and translation, on
                            this computer or on another one over Tailscale. On that computer, run
                            <code>tailscale-phone.ps1 -Mode On</code>.
                        </p>
                        <div class="dd__fields">
                            <label class="dd__field">
                                <span><input type="radio" name="svcLoc" checked="@(_svcLocation == "Local")" @onchange="@(() => _svcLocation = "Local")" /> Local: this computer</span>
                            </label>
                            <label class="dd__field">
                                <span><input type="radio" name="svcLoc" checked="@(_svcLocation == "Remote")" @onchange="@(() => _svcLocation = "Remote")" /> Remote: another computer</span>
                            </label>
                            <label class="dd__field">Remote host (Tailscale IP or name)
                                <input type="text" class="dd__testInput" @bind="_svcRemoteHost" autocomplete="off"
                                       placeholder="100.89.6.69" disabled="@(_svcLocation != "Remote")" />
                            </label>
                        </div>
                        <p class="dd__tableHint">
                            In use now (since Isa started): <strong>@(StartServices.Location == "Remote" ? $"Remote ({StartServices.RemoteHost})" : "Local")</strong>.
                            @if (SavedLocationLabel != CurrentLocationLabel)
                            {
                                <span> Saved for the next start: <strong>@SavedLocationLabel</strong>. Restart Isa to use it.</span>
                            }
                        </p>
                    </div>

                    <div class="dd__card">
                        <div class="dd__cardHeader">
                            <h3>Voice and translation</h3>
                            <span class="dd__tag dd__tag--green">APPLIES AT ONCE</span>
                        </div>
                        <p class="dd__cardHint">
                            Switched off, Isa never calls the service, so it doesn't need to be running.
                            To free its memory, also stop it where it runs (Stop voice, Stop translation).
                        </p>
                        <div class="dd__fields">
                            <label class="dd__field">
                                <span><input type="checkbox" @bind="_svcVoice" /> Voice (Kokoro)</span>
                                <span class="dd__tableHint">Off: the Library's Listen uses the device's own voice.</span>
                            </label>
                            <label class="dd__field">
                                <span><input type="checkbox" @bind="_svcTranslation" /> Translation (NLLB-200)</span>
                                <span class="dd__tableHint">Off: the translation step is skipped for every question.</span>
                            </label>
                        </div>
                    </div>

                    <div class="dd__card dd__card--wide">
                        <div class="dd__cardHeader">
                            <h3>Addresses in use</h3>
                        </div>
                        <table class="dd__table">
                            <thead><tr><th>Service</th><th>Address</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var row in ServiceRows)
                                {
                                    <tr>
                                        <td>@row.Name</td>
                                        <td><code>@row.Url</code></td>
                                        <td>@(row.Off ? "Switched off" : _svcCheck.TryGetValue(row.Key, out var st) ? st : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="dd__saveRow">
                            <button type="button" class="dd__btn dd__btn--primary" @onclick="SaveServices">Save</button>
                            <button type="button" class="dd__btn dd__btn--ghost" @onclick="CheckServices" disabled="@_svcChecking">@(_svcChecking ? "Checking..." : "Check services")</button>
                            <button type="button" class="dd__btn dd__btn--ghost" @onclick="ResetServices">Back to appsettings.json</button>
                            @if (!string.IsNullOrEmpty(_svcMessage))
                            {
                                <span class="dd__saveNote @(_svcMessageIsError ? "dd__saveNote--err" : "dd__saveNote--ok")">@_svcMessage</span>
                            }
                        </div>
                        <p class="dd__tableHint">Saved to <code>@ServiceSettings.FileName</code> in the project folder (this computer only, not in Git).</p>
                    </div>
                </div>
            }
            else
            {
                <div class="dd__topbar">
                    <h1 class="dd__pageTitle">@CurrentSectionLabel</h1>
                </div>
                <div class="dd__stub">
                    <p>Not built yet.</p>
                </div>
            }
        </section>
    </div>
}

<a href="/" class="dd__back" data-enhance-nav="false">&larr; Back home</a>

@code {
    private sealed record SectionInfo(string Key, string Label);

    private static readonly SectionInfo[] Sections =
    {
        new("compliance", "Compliance policy"),
        new("roleaccess", "Role access"),
        new("models", "Models, RAG, access & ticketing"),
        new("frontend", "Front end"),
        new("testing", "Testing console"),
        new("translation", "Translation test"),
        new("vectorsearch", "Vector search test"),
        new("ruletester", "Rule tester"),
        new("content", "Content import"),
        new("services", "Services (this computer)"),
        new("health", "Health alerts"),
    };

    private string ActiveSection = "compliance";

    // ---- Services (this computer) -> appsettings.Local.json ---------
    // Where Keycloak, Ollama, the voice, embeddings and translation run (needs a restart), and whether the
    // voice and translation are used at all (applies at once). See Services/LocalServiceSettings.cs.

    private string _svcLocation = "Local";
    private string _svcRemoteHost = "";
    private bool _svcVoice;
    private bool _svcTranslation;
    private string _svcMessage = "";
    private bool _svcMessageIsError;
    private bool _svcChecking;
    private Dictionary<string, string> _svcCheck = new();

    private void LoadServiceSettings()
    {
        _svcLocation = ServiceSettings.Location.Equals("Remote", StringComparison.OrdinalIgnoreCase) ? "Remote" : "Local";
        _svcRemoteHost = ServiceSettings.RemoteHost;
        _svcVoice = ServiceSettings.VoiceOn;
        _svcTranslation = ServiceSettings.TranslationOn;
    }

    private string CurrentLocationLabel => StartServices.Location == "Remote" ? $"Remote ({StartServices.RemoteHost})" : "Local";
    private string SavedLocationLabel => ServiceSettings.Location.Equals("Remote", StringComparison.OrdinalIgnoreCase)
        ? $"Remote ({ServiceSettings.RemoteHost})" : "Local";

    private (string Location, string Host, bool Voice, bool Translation) ServiceSnapshot() =>
        (ServiceSettings.Location, ServiceSettings.RemoteHost, ServiceSettings.VoiceOn, ServiceSettings.TranslationOn);

    private void LogServiceChanges(string who, (string Location, string Host, bool Voice, bool Translation) before)
    {
        ChangeLog.Add(who, "Services", "Where the services run", before.Location, ServiceSettings.Location);
        ChangeLog.Add(who, "Services", "Remote host", before.Host, ServiceSettings.RemoteHost);
        ChangeLog.Add(who, "Services", "Voice", before.Voice ? "on" : "off", ServiceSettings.VoiceOn ? "on" : "off");
        ChangeLog.Add(who, "Services", "Translation", before.Translation ? "on" : "off", ServiceSettings.TranslationOn ? "on" : "off");
        if (_changeLogVisible) _changes = ChangeLog.Recent(50);
    }

    private sealed record ServiceRow(string Key, string Name, string Url, string HealthPath, bool Off);

    private IEnumerable<ServiceRow> ServiceRows => new[]
    {
        new ServiceRow("Keycloak:Authority", "Keycloak (sign-in)", StartServices.Endpoints["Keycloak:Authority"], "", false),
        new ServiceRow("Ollama:Endpoint", "Ollama (the model)", StartServices.Endpoints["Ollama:Endpoint"], "/api/version", false),
        new ServiceRow("Tts:Endpoint", "Voice (Kokoro)", StartServices.Endpoints["Tts:Endpoint"], "/v1/models", !ServiceSettings.VoiceOn),
        new ServiceRow("Embeddings:BaseUrl", "Embeddings", StartServices.Endpoints["Embeddings:BaseUrl"], "/health", false),
        new ServiceRow("Translation:Endpoint", "Translation (NLLB-200)", StartServices.Endpoints["Translation:Endpoint"], "/health", !ServiceSettings.TranslationOn),
    };

    private async Task SaveServices()
    {
        if (!Settings.CanAccessDevDashboard && !_isDev) return;
        try
        {
            var who = await WhoAsync();
            var before = ServiceSnapshot();
            ServiceSettings.Save(_svcLocation, _svcRemoteHost, _svcVoice, _svcTranslation);
            LoadServiceSettings();
            LogServiceChanges(who, before);
            _svcCheck.Clear();
            _svcMessage = "Saved. Voice " + (_svcVoice ? "on" : "off") + " and translation " + (_svcTranslation ? "on" : "off") + " apply now."
                + (SavedLocationLabel != CurrentLocationLabel ? " Restart Isa to use " + SavedLocationLabel + "." : "");
            _svcMessageIsError = false;
        }
        catch (Exception ex)
        {
            _svcMessage = "Could not save: " + ex.Message;
            _svcMessageIsError = true;
        }
    }

    private async Task ResetServices()
    {
        if (!Settings.CanAccessDevDashboard && !_isDev) return;
        try
        {
            var who = await WhoAsync();
            var before = ServiceSnapshot();
            ServiceSettings.Reset();
            LoadServiceSettings();
            LogServiceChanges(who, before);
            _svcCheck.Clear();
            _svcMessage = "Removed " + ServiceSettings.FileName + ": appsettings.json applies"
                + (SavedLocationLabel != CurrentLocationLabel ? ". Restart Isa to use " + SavedLocationLabel + "." : ".");
            _svcMessageIsError = false;
        }
        catch (Exception ex)
        {
            _svcMessage = "Could not reset: " + ex.Message;
            _svcMessageIsError = true;
        }
    }

    private async Task CheckServices()
    {
        if (!Settings.CanAccessDevDashboard && !_isDev) return;
        _svcChecking = true;
        _svcCheck.Clear();
        StateHasChanged();
        var http = HttpFactory.CreateClient();
        http.Timeout = TimeSpan.FromSeconds(4);
        foreach (var row in ServiceRows.Where(r => !r.Off))
        {
            try
            {
                using var resp = await http.GetAsync(row.Url.TrimEnd('/') + row.HealthPath);
                _svcCheck[row.Key] = resp.IsSuccessStatusCode ? "Answers" : $"Answers with {(int)resp.StatusCode}";
            }
            catch
            {
                _svcCheck[row.Key] = "Not reachable";
            }
            StateHasChanged();
        }
        _svcChecking = false;
    }

    // ---- Ticketing (Salesforce) settings -> dev-keys.json ---------

    private string _sfOrgUrl = "";
    private string _sfApiVersion = "";
    private string _sfClientId = "";
    private string _sfSecret = "";
    private bool _sfSecretIsSet;
    private string _sfMessage = "";
    private bool _sfMessageIsError;

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }
    private bool _isDev;   // holds the Keycloak role dashboard_dev

    protected override async Task OnInitializedAsync()
    {
        _isDev = await DevAccess.HasDevRoleAsync(AuthState);
        LoadSalesforce();
        LoadOutputSettings();
        LoadServiceSettings();
    }

    private void LoadSalesforce()
    {
        try
        {
            var keys = DevKeys.GetSalesforce();
            _sfOrgUrl = keys.OrgUrl;
            _sfApiVersion = keys.ApiVersion;
            _sfClientId = keys.ClientId;
            _sfSecretIsSet = keys.SecretIsSet;
        }
        catch (Exception ex)
        {
            _sfMessage = "Could not read dev-keys.json: " + ex.Message;
            _sfMessageIsError = true;
        }
    }

    private async Task SaveSalesforce()
    {
        if (!Settings.CanAccessDevDashboard && !_isDev) return;
        try
        {
            var who = await WhoAsync();
            var old = DevKeys.GetSalesforce();
            var secretChanged = !string.IsNullOrEmpty(_sfSecret);
            DevKeys.SaveSalesforce(_sfOrgUrl, _sfApiVersion, _sfClientId, _sfSecret);
            _sfSecret = "";
            LoadSalesforce();
            ChangeLog.Add(who, "Ticketing (Salesforce)", "Org URL", old.OrgUrl, _sfOrgUrl);
            ChangeLog.Add(who, "Ticketing (Salesforce)", "API version", old.ApiVersion, _sfApiVersion);
            ChangeLog.Add(who, "Ticketing (Salesforce)", "Client ID", old.ClientId, _sfClientId);
            if (secretChanged) ChangeLog.Add(who, "Ticketing (Salesforce)", "Client secret", "(hidden)", "changed (value not logged)");
            if (_changeLogVisible) _changes = ChangeLog.Recent(50);
            _sfMessage = "Saved to dev-keys.json";
            _sfMessageIsError = false;
        }
        catch (Exception ex)
        {
            _sfMessage = "Could not save: " + ex.Message;
            _sfMessageIsError = true;
        }
    }
    private string CurrentSectionLabel =>
        Sections.First(s => s.Key == ActiveSection).Label;

    // ---- Compliance policy state ---------------------------------

    // Real settings: the four answer-quality numbers are saved by OutputComplianceSettings and read on every question
    // (NLI, confidence and strong match by the output compliance stage; the search pass mark by vector search).
    private int ConfidenceThreshold = (int)Math.Round(OutputComplianceSettings.DefaultConfidence * 100);
    private int NliThresholdPct = (int)Math.Round(OutputComplianceSettings.DefaultNli * 100);
    private int StrongMatchPct = (int)Math.Round(OutputComplianceSettings.DefaultStrongMatch * 100);
    private int SearchPassMarkPct = (int)Math.Round(OutputComplianceSettings.DefaultSearchPassMark * 100);
    private string _saveMessage = "";

    private void LoadOutputSettings()
    {
        ConfidenceThreshold = (int)Math.Round(OutputSettings.ConfidenceThreshold * 100);
        NliThresholdPct = (int)Math.Round(OutputSettings.NliThreshold * 100);
        StrongMatchPct = (int)Math.Round(OutputSettings.StrongMatch * 100);
        SearchPassMarkPct = (int)Math.Round(OutputSettings.SearchPassMark * 100);
    }

    private void OnStrongMatchChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) StrongMatchPct = value;
    }

    private void OnSearchPassMarkChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value)) SearchPassMarkPct = value;
    }

    private void OnNliChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            NliThresholdPct = value;
        }
    }

    private async Task ResetOutputSettings()
    {
        if (!Settings.CanAccessDevDashboard && !_isDev) return;
        var who = await WhoAsync();
        var before = (Nli: OutputSettings.NliThreshold, Conf: OutputSettings.ConfidenceThreshold, Strong: OutputSettings.StrongMatch, Search: OutputSettings.SearchPassMark);
        OutputSettings.ResetToDefaults();
        LoadOutputSettings();
        LogOutputChanges(who, before.Nli, before.Conf, before.Strong, before.Search);
        _saveMessage = "Compliance settings reset to the appsettings.json values.";
    }

    private void OnConfidenceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            ConfidenceThreshold = value;
        }
    }

    // ---- Lists shown on the Compliance policy page (read-only, from the live rules and settings) ----

    private IEnumerable<IsaChatApp.Services.Rules.RuleSummary> HandOffRules =>
        RuleSet.AllRules().Where(r => r.Outcome == "hand_off" || r.Outcome == "stop")
            .OrderBy(r => r.RuleId, StringComparer.Ordinal);

    private sealed record CheckRow(string Name, string State, string Note);

    private bool ConfigOn(string key, bool fallback)
    {
        var v = Config[key];
        return string.IsNullOrWhiteSpace(v) ? fallback : !string.Equals(v, "false", StringComparison.OrdinalIgnoreCase);
    }

    private static string Num(double v) => v.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    private IEnumerable<CheckRow> OutputCheckRows
    {
        get
        {
            var fixedState = ConfigOn("OutputCompliance:FixedChecks", true) ? "On" : "Off";
            var rulesState = ConfigOn("Rules:Engine", true) ? "On" : "Off";
            return new[]
            {
                new CheckRow("Source check", "Always on", "The passage the answer cites must be one the search retrieved. If not, the question goes to a person."),
                new CheckRow("Source still says TBD", fixedState, "A passage that is not finished is never reworded. The question goes to a person."),
                new CheckRow("Rule recheck", rulesState, "The written answer is checked against each applicable rule's forbidden phrases. A hit follows that rule's outcome (a person, or a stop)."),
                new CheckRow("Answer shape", fixedState, "A \"how many\" question needs a number, \"when\" a date or period, \"who\" a role or team. If not, the question goes to a person."),
                new CheckRow("Answer support (NLI)", "Pass mark " + Num(OutputSettings.NliThreshold), "Each sentence is scored against the cited passage. Failing sentences are dropped when most of the answer is supported."),
                new CheckRow("Numbers, must-stays-must, contact details", fixedState, "A number, a \"must\" that became \"should\", or an email or phone number that is not in the passage counts as a failed check."),
                new CheckRow("Confidence", "Threshold " + Num(OutputSettings.ConfidenceThreshold), "Search strength averaged with the share of supported sentences. Below the threshold counts as a failed check."),
                new CheckRow("After a failed check", "Strong-match mark " + Num(OutputSettings.StrongMatch), "A search score at or above the mark shows ISACA's own words from the passage; below it the question goes to a person."),
            };
        }
    }

    // ---- Save changes / change log ------------------------------------

    private bool _savedMessageVisible;
    private bool _changeLogVisible;
    private IReadOnlyList<SettingsChangeLog.Entry> _changes = Array.Empty<SettingsChangeLog.Entry>();

    private void ToggleChangeLog()
    {
        _changeLogVisible = !_changeLogVisible;
        if (_changeLogVisible) _changes = ChangeLog.Recent(50);
    }

    /// <summary>Who is making a change: the signed-in name, or a note that nobody is signed in (the role picker on this computer).</summary>
    private async Task<string> WhoAsync()
    {
        try
        {
            var name = AuthState is null ? null : (await AuthState).User.Identity?.Name;
            if (!string.IsNullOrWhiteSpace(name)) return name!;
        }
        catch { }
        return "not signed in (this computer)";
    }

    private void LogOutputChanges(string who, double nli, double conf, double strong, double search)
    {
        ChangeLog.Add(who, "Compliance policy", "NLI pass mark", Num(nli), Num(OutputSettings.NliThreshold));
        ChangeLog.Add(who, "Compliance policy", "Answer confidence threshold", Num(conf), Num(OutputSettings.ConfidenceThreshold));
        ChangeLog.Add(who, "Compliance policy", "Strong-match mark", Num(strong), Num(OutputSettings.StrongMatch));
        ChangeLog.Add(who, "Compliance policy", "Search pass mark", Num(search), Num(OutputSettings.SearchPassMark));
        if (_changeLogVisible) _changes = ChangeLog.Recent(50);
    }

    private async Task SaveChanges()
    {
        if (!Settings.CanAccessDevDashboard && !_isDev) return;
        try
        {
            var who = await WhoAsync();
            var before = (Nli: OutputSettings.NliThreshold, Conf: OutputSettings.ConfidenceThreshold, Strong: OutputSettings.StrongMatch, Search: OutputSettings.SearchPassMark);
            OutputSettings.Save(NliThresholdPct / 100.0, ConfidenceThreshold / 100.0, StrongMatchPct / 100.0, SearchPassMarkPct / 100.0);
            LogOutputChanges(who, before.Nli, before.Conf, before.Strong, before.Search);
            _saveMessage = "Saved: NLI pass mark " + Num(OutputSettings.NliThreshold)
                + ", confidence threshold " + Num(OutputSettings.ConfidenceThreshold)
                + ", strong-match mark " + Num(OutputSettings.StrongMatch)
                + ", search pass mark " + Num(OutputSettings.SearchPassMark)
                + ". Applies to the next question.";
        }
        catch (Exception ex)
        {
            _saveMessage = "Could not save: " + ex.Message;
        }
        _savedMessageVisible = true;
        StateHasChanged();
        await Task.Delay(5000);
        _savedMessageVisible = false;
        await InvokeAsync(StateHasChanged);
    }
}
