@page "/isa-config"
@* ============================================================
   IsaConfig.razor

   Deliberately not in NavMenu.razor or linked anywhere on the site --
   reachable only by a visitor (i.e. the team) typing /isa-config
   directly. Changes apply immediately, app-wide, for every open
   ChatWidget, since WidgetSettings is a singleton -- and reset to
   defaults on the next app restart, since nothing here is written to
   disk.
   ============================================================ *@
@using System
@using IsaChatApp.Services
@inject WidgetSettings Settings
@rendermode InteractiveServer

<PageTitle>Isa Configuration</PageTitle>

<h1>Isa Configuration</h1>
<p class="text-muted">
    Not linked anywhere in the site &mdash; reachable only by navigating
    to <code>/isa-config</code> directly. Changes take effect immediately
    for every open chat window and reset to defaults on app restart
    (nothing here is persisted to disk).
</p>

<div class="form-check form-switch">
    <input class="form-check-input" type="checkbox" role="switch" id="useIsaLabel"
           checked="@Settings.UseIsaLabel"
           @onchange="@(e => Settings.UseIsaLabel = (bool)e.Value!)" />
    <label class="form-check-label" for="useIsaLabel">
        Show &ldquo;Isa&rdquo; instead of the raw model name in the chat window
    </label>
</div>

<p class="mt-3">
    Currently, AI replies in the chat are labeled
    <strong>@(Settings.UseIsaLabel ? "Isa" : "the raw model/host string (e.g. “qwen2.5-coder:1.5b-instruct (remote)”)")</strong>.
    This only affects the chat transcript &mdash; the model picker dropdown
    inside the widget always shows real model names, since that's a
    testing tool for the team.
</p>

<div class="form-check form-switch mt-3">
    <input class="form-check-input" type="checkbox" role="switch" id="showResponseTime"
           checked="@Settings.ShowResponseTime"
           @onchange="@(e => Settings.ShowResponseTime = (bool)e.Value!)" />
    <label class="form-check-label" for="showResponseTime">
        Show response time next to the model name / &ldquo;Isa&rdquo; label on AI replies
    </label>
</div>

<p class="mt-3">
    Currently, AI replies
    <strong>@(Settings.ShowResponseTime ? "show" : "don't show")</strong>
    how long they took (e.g. &ldquo;Isa &middot; 1.4s&rdquo;), and the live status
    message shown while a request is in flight
    <strong>@(Settings.ShowResponseTime ? "also ticks up its own elapsed time" : "stays plain")</strong>.
    Every completed reply is still logged to the
    <a href="/content-health-dashboard">Content Health Dashboard</a> either way &mdash;
    this only controls what shows up in the chat window itself.
</p>

<hr class="mt-4" />

<h2 class="h4">Bubble colors</h2>
<p class="text-muted">
    Pick from ISACA's full brand palette (Primary, Secondary, Tertiary)
    for the user and Isa chat bubbles, plus the 100% / 60% / 30% / 10%
    screened tone &mdash; same percentages as the swatches on
    brand.isaca.org. Changes apply immediately to every open chat window.
</p>

<div class="row g-3" style="max-width: 640px;">
    <div class="col-12">
        <label class="form-label" for="userBubbleColor">Your (user) bubble color</label>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select" id="userBubbleColor"
                    value="@Settings.UserBubbleColorName"
                    @onchange="@(e => Settings.UserBubbleColorName = (string)e.Value!)">
                @foreach (var color in WidgetSettings.IsacaColors)
                {
                    <option value="@color.Name" selected="@(color.Name == Settings.UserBubbleColorName)">@color.Name</option>
                }
            </select>
            <select class="form-select" style="max-width: 110px;" id="userBubblePercent"
                    value="@Settings.UserBubbleColorPercent"
                    @onchange="@(e => Settings.UserBubbleColorPercent = int.Parse((string)e.Value!))">
                @foreach (var pct in WidgetSettings.TintPercents)
                {
                    <option value="@pct" selected="@(pct == Settings.UserBubbleColorPercent)">@pct%</option>
                }
            </select>
            <span class="d-inline-block flex-shrink-0" style="width: 1.6rem; height: 1.6rem; border-radius: 4px; border: 1px solid #ccc; background: @Settings.UserBubbleColor;"></span>
        </div>
    </div>

    <div class="col-12">
        <label class="form-label" for="aiBubbleColor">Isa (AI) bubble color</label>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select" id="aiBubbleColor"
                    value="@Settings.AiBubbleColorName"
                    @onchange="@(e => Settings.AiBubbleColorName = (string)e.Value!)">
                @foreach (var color in WidgetSettings.IsacaColors)
                {
                    <option value="@color.Name" selected="@(color.Name == Settings.AiBubbleColorName)">@color.Name</option>
                }
            </select>
            <select class="form-select" style="max-width: 110px;" id="aiBubblePercent"
                    value="@Settings.AiBubbleColorPercent"
                    @onchange="@(e => Settings.AiBubbleColorPercent = int.Parse((string)e.Value!))">
                @foreach (var pct in WidgetSettings.TintPercents)
                {
                    <option value="@pct" selected="@(pct == Settings.AiBubbleColorPercent)">@pct%</option>
                }
            </select>
            <span class="d-inline-block flex-shrink-0" style="width: 1.6rem; height: 1.6rem; border-radius: 4px; border: 1px solid #ccc; background: @Settings.AiBubbleColor;"></span>
        </div>
    </div>
</div>

<hr class="mt-4" />

<h2 class="h4">Role &amp; dashboard access</h2>
<p class="text-muted">
    No real login here &mdash; this just lets you pick &ldquo;who you
    are&rdquo; for the whole app, so the Dev Dashboard and Content
    Health Dashboard (CHD) icons on the chat widget (and the pages
    themselves, if you go straight to the URL) show or block based on
    the role below.
</p>

<div class="btn-group" role="group" aria-label="Current role">
    @foreach (var role in Enum.GetValues<WidgetSettings.UserRole>())
    {
        <input type="radio" class="btn-check" name="currentRole" id="@($"role-{role}")" autocomplete="off"
               checked="@(Settings.CurrentRole == role)"
               @onchange="@(() => Settings.CurrentRole = role)" />
        <label class="btn btn-outline-secondary" for="@($"role-{role}")">@role</label>
    }
</div>

<table class="table table-sm mt-3" style="max-width: 480px;">
    <thead>
        <tr>
            <th>Role</th>
            <th>Dev Dashboard</th>
            <th>Content Health Dashboard</th>
        </tr>
    </thead>
    <tbody>
        <tr class="@(Settings.CurrentRole == WidgetSettings.UserRole.User ? "table-active" : "")">
            <td>User</td><td>No</td><td>No</td>
        </tr>
        <tr class="@(Settings.CurrentRole == WidgetSettings.UserRole.Developer ? "table-active" : "")">
            <td>Developer</td><td>Yes</td><td>No</td>
        </tr>
        <tr class="@(Settings.CurrentRole == WidgetSettings.UserRole.Executive ? "table-active" : "")">
            <td>Executive</td><td>Yes</td><td>Yes</td>
        </tr>
        <tr class="@(Settings.CurrentRole == WidgetSettings.UserRole.Manager ? "table-active" : "")">
            <td>Manager</td><td>No</td><td>Yes</td>
        </tr>
    </tbody>
</table>

<p>
    Signed in as <strong>@Settings.CurrentRole</strong> &mdash;
    Dev Dashboard: <strong>@(Settings.CanAccessDevDashboard ? "accessible" : "blocked")</strong>,
    Content Health Dashboard: <strong>@(Settings.CanAccessContentHealthDashboard ? "accessible" : "blocked")</strong>.
</p>

<hr class="mt-4" />

<p>
    <a href="/throbber-test" target="_blank">Throbber test page &rarr;</a>
    <br />
    <span class="text-muted">Standalone playground for every Throbber setting (spinning, hover, color-cycle, size, etc.) -- opens in a new tab.</span>
</p>
