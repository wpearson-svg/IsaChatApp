@page "/present"
@layout LandingLayout
@using IsaChatApp.Services
@using IsaChatApp.Services.Presentation
@inject WidgetSettings Settings
@inject PresentationDeck Deck
@inject IJSRuntime JS
@inject IsaChatApp.Services.Orchestrator.OllamaChatService Ollama
@inject SalesforceTicketService Salesforce
@inject DevAccessService DevAccess
@implements IAsyncDisposable
@rendermode InteractiveServer

@* ============================================================
   Present.razor -- the presentation slides, inside Isa.

   One slide at a time, full screen, with Isa's normal chat widget in
   the bottom-right corner the whole time (LandingLayout places it),
   so the talk moves into the live demo without switching windows.
   The "Live demo" slide keeps the right side empty for the chat.

   - Wording: presentation/slides.json (Services/Presentation/
     PresentationDeck.cs). Edit it and refresh; no restart needed.
   - Keys: Present.razor.js (arrows, Page Up/Down for a clicker, Home,
     End, F for full screen). The small arrows in the footer do the same.
   - Intro: wwwroot/present/intro.html (Matthew's Isa_C_Intro.html, with
     the ring half blue, half green) plays over the first slide, "Meet
     Isa", when the page opens there. I replays it.
   - Off by default: the team switches it on at /isa-config
     (WidgetSettings.PresentationEnabled), so chapter leaders never come
     across it.
   - Styles: Present.razor.css, ISACA colors and type only
     (BRAND_GUIDELINES.md). The C shape is the approved one.
   ============================================================ *@

<PageTitle>Isa | Presentation</PageTitle>

@if (!Settings.PresentationEnabled)
{
    <div class="present present--off">
        <div class="present__offBox">
            <h1>The presentation is switched off</h1>
            <p>Switch it on at <a href="/isa-config">/isa-config</a> (Presentation), then refresh this page.</p>
        </div>
    </div>
}
else if (_slides.Count == 0)
{
    <div class="present present--off">
        <div class="present__offBox">
            <h1>No slides to show</h1>
            <p>@(_error ?? "presentation/slides.json has no slides.")</p>
        </div>
    </div>
}
else
{
    @* Dark Blue until the intro starts (Present.razor.js, playIntro), so the
       landing slide doesn't show for a moment before the animation. *@
    @if (_introPending)
    {
        <div class="present__introCover" aria-hidden="true"></div>
    }
    @* Opening screen: a quick check, then "Ready" in ISACA Green. The next-slide key fades it and starts the intro. *@
    @if (_gate != Gate.Off)
    {
        <div class="present__gate @(_gateLeaving ? "is-leaving" : "")" role="status" aria-live="polite">
            @if (_gate == Gate.Checking)
            {
                <p class="present__gateWord present__gateWord--checking">Checking&hellip;</p>
            }
            else if (_gate == Gate.Ready)
            {
                <p class="present__gateWord">Ready</p>
            }
            else
            {
                <p class="present__gateWord present__gateWord--not">Not ready</p>
                <ul class="present__gateProblems">
                    @foreach (var problem in _gateProblems) { <li>@problem</li> }
                </ul>
                <p class="present__gateHint">Fix it and this updates on its own. The next-slide key starts anyway.</p>
            }
        </div>
    }
    @* Live Salesforce Cases (Alt+C): Isa's own read-only view of the newest Cases, refreshed every 3 seconds. *@
    @if (_casesOpen)
    {
        <div class="present__cases" role="dialog" aria-label="Salesforce Cases, live">
            <div class="present__casesHead">
                <h2>Salesforce Cases <span>live</span></h2>
                <small>@(_casesUpdated is { } t ? $"Updated {t:h:mm:ss tt}" : "Loading…") &middot; Esc closes</small>
            </div>
            @if (_cases is { Ok: false } bad)
            {
                <p class="present__casesNote">@CasesError(bad.Error)</p>
            }
            else if (_cases is { Rows.Count: 0 })
            {
                <p class="present__casesNote">No Isa Cases yet. Ask a question Isa passes to a person and it appears here.</p>
            }
            else if (_cases is { } list)
            {
                <table class="present__casesTable">
                    <thead><tr><th>Case</th><th>Isa ref</th><th>Status</th><th>Priority</th><th>Requested by</th><th>Chapter</th><th>Created</th></tr></thead>
                    <tbody>
                        @foreach (var row in list.Rows)
                        {
                            var fresh = row.CreatedAt is { } created && DateTimeOffset.UtcNow - created < TimeSpan.FromMinutes(2);
                            <tr class="@(fresh ? "is-new" : "")">
                                <td>@row.CaseNumber</td>
                                <td>@row.IsaReference</td>
                                <td>@row.Status</td>
                                <td class="@(row.Priority == "High" ? "is-high" : "")">@row.Priority</td>
                                <td>@row.RequestedBy</td>
                                <td>@row.Chapter</td>
                                <td>@(row.CreatedAt is { } at ? at.ToLocalTime().ToString("h:mm:ss tt") : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
    @* A dashboard over the slides (Alt+6 Developer Dashboard, Alt+7 Content Health). Esc or the button returns to the same slide. *@
    @if (_frameUrl is not null)
    {
        <div class="present__frame">
            <button type="button" class="present__frameBack" @onclick="CloseFrame">&#8592; Back to slides</button>
            <iframe src="@_frameUrl" title="Dashboard"></iframe>
        </div>
    }
    var s = _slides[_index];
    var dark = s.Kind is "landing" or "cover" or "closing";
    <div class="present">
        <div class="present__stage present__stage--@s.Kind @(dark ? "is-dark" : "")" @key="_index">

            <div class="present__progress" aria-hidden="true">
                <span style="width:@(((_index + 1) * 100.0 / _slides.Count).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </div>

            @if (dark)
            {
                <svg class="present__c" viewBox="-2 -2 204 204" aria-hidden="true" focusable="false"><path d="@CPath" /></svg>
            }
            else
            {
                @* White slides: a row of small Cs, blue and green, coming in from
                   the right edge along the top, a third of the slide wide. The Cs
                   turn as in the graphic strip on ISACA's Visual Style page:
                   opening up, then down-left, then right, repeating (StripTurns). *@
                <div class="present__cornerStrip" aria-hidden="true">
                    @for (var i = 0; i < 6; i++)
                    {
                        <svg viewBox="-2 -2 204 204" focusable="false" class="@(i % 2 == 0 ? "is-blue" : "is-green")" style="transform:rotate(@(StripTurns[i % 3])deg)"><path d="@CPath" /></svg>
                    }
                </div>
            }

            <div class="present__body">
                @if (!string.IsNullOrEmpty(s.Section))
                {
                    <p class="present__section">@s.Section</p>
                }

                @switch (s.Kind)
                {
                    case "landing":
                        var (titleStart, titleName) = SplitLastWord(s.Title);
                        @* The intro's ring, large: the blue C's left half and the
                           mirrored green C's right half, with Isa in the middle. *@
                        <div class="present__landing">
                            <div class="present__landingText">
                                <h1 class="present__landingTitle">@titleStart<span class="present__landingName">@titleName</span></h1>
                                <p class="present__landingLead">@s.Lead</p>
                                @* A C strip (ISACA Visual Style), alternating blue and green. *@
                                <div class="present__strip" aria-hidden="true">
                                    @for (var i = 0; i < 6; i++)
                                    {
                                        <svg viewBox="-2 -2 204 204" focusable="false" class="@(i % 2 == 0 ? "is-blue" : "is-green")"><path d="@CPath" /></svg>
                                    }
                                </div>
                            </div>
                            <svg class="present__pop" viewBox="-2 -2 204 204" aria-hidden="true" focusable="false"><path d="@CPath" /></svg>
                            <div class="present__ring" aria-hidden="true">
                                <svg viewBox="-2 -2 204 204" focusable="false">
                                    <defs>
                                        <clipPath id="present-ring-left"><rect x="-2" y="-2" width="102" height="204" /></clipPath>
                                        <clipPath id="present-ring-right"><rect x="100" y="-2" width="102" height="204" /></clipPath>
                                    </defs>
                                    <circle cx="100" cy="100" r="58" fill="#ffffff" />
                                    <g clip-path="url(#present-ring-left)"><path d="@CPath" fill="#00a4e4" /></g>
                                    <g clip-path="url(#present-ring-right)"><path d="@CPath" fill="#6cb33f" transform="translate(200 0) scale(-1 1)" /></g>
                                </svg>
                                <span class="present__ringMark"><Throbber Spinning="false" /></span>
                            </div>
                        </div>
                        break;

                    case "problem":
                        @* The title across the top, then two columns that line up top
                           and bottom: the big number over the blue panel, the problem
                           over the green one. *@
                        <div class="present__problem">
                            <h1 class="present__title">@s.Title</h1>
                            <div class="present__problemTop">
                                <div class="present__stat">
                                    <span class="present__statNum">@s.Stat</span>
                                    <span class="present__statLabel">@s.StatLabel</span>
                                </div>
                                <p class="present__lead">@Emphasised(s.Lead)</p>
                            </div>
                            <div class="present__answers">
                                @foreach (var item in s.Items)
                                {
                                    <div class="present__answer is-@item.Status">
                                        <svg viewBox="-2 -2 204 204" aria-hidden="true" focusable="false"><path d="@CPath" /></svg>
                                        <span>@item.Title</span>
                                    </div>
                                }
                            </div>
                        </div>
                        break;

                    case "cover":
                        <div class="present__cover">
                            <span class="present__mark"><Throbber Spinning="false" WordColor="#ffffff" /></span>
                            <h1 class="present__coverTitle">@s.Title</h1>
                            @* Ten stages joined end to end, alternating blue and green. They
                               light up one after another, left to right, like a question
                               passing through each stage (Present.razor.css, present-stage). *@
                            <ol class="present__track" aria-hidden="true">
                                @for (var i = 0; i < 10; i++)
                                {
                                    <li class="@(i % 2 == 0 ? "is-blue" : "is-green")" style="animation-delay:@(i * 375)ms"></li>
                                }
                            </ol>
                            <p class="present__coverLead">@s.Lead</p>
                            <p class="present__coverNote">@s.Note</p>
                        </div>
                        break;

                    case "closing":
                        <div class="present__closing">
                            <span class="present__mark present__mark--small"><Throbber Spinning="false" WordColor="#ffffff" /></span>
                            <h1 class="present__quote">@s.Title</h1>
                            <p class="present__coverSub">@s.Subtitle</p>
                            <p class="present__coverNote">@s.Note</p>
                        </div>
                        break;

                    case "rules":
                        <h1 class="present__title">@s.Title</h1>
                        <p class="present__lead">@s.Lead</p>
                        <div class="present__cards present__cards--@s.Items.Count">
                            @for (var i = 0; i < s.Items.Count; i++)
                            {
                                var item = s.Items[i];
                                <div class="present__card">
                                    <span class="present__cardNum">@((i + 1).ToString("00"))</span>
                                    <h2 class="present__cardTitle">@item.Title</h2>
                                    <p class="present__cardText">@item.Text</p>
                                </div>
                            }
                        </div>
                        break;

                    case "pipeline":
                        <h1 class="present__title">@s.Title</h1>
                        <p class="present__lead">@s.Lead</p>
                        @* The stages light up one after another, left to right (like the
                           dots on "Pipeline built"); under them, each path is a bar
                           under the stages it uses, so the cheap path visibly skips
                           the AI stages. *@
                        <ol class="present__pipe" style="--stages:@s.Stages.Count">
                            @for (var i = 0; i < s.Stages.Count; i++)
                            {
                                var stage = s.Stages[i];
                                <li class="present__pipeStage @(string.IsNullOrEmpty(stage.Path) ? "" : $"is-{stage.Path}")">
                                    <span class="present__pipeDot" style="animation-delay:@(i * 375)ms">@(i + 1)</span>
                                    <span class="present__pipeName">@stage.Name</span>
                                </li>
                            }
                        </ol>
                        <div class="present__paths">
                            @foreach (var path in s.Paths)
                            {
                                <div class="present__path is-@path.Color">
                                    <p class="present__pathLabel"><strong>@path.Title</strong> @path.Text</p>
                                    <ol class="present__pathBar" style="--stages:@s.Stages.Count" aria-hidden="true">
                                        @for (var n = 1; n <= s.Stages.Count; n++)
                                        {
                                            var on = path.Stages.Contains(n);
                                            var start = on && !path.Stages.Contains(n - 1);
                                            var end = on && !path.Stages.Contains(n + 1);
                                            <li class="@(on ? "is-on" : "") @(start ? "is-start" : "") @(end ? "is-end" : "")"></li>
                                        }
                                    </ol>
                                </div>
                            }
                        </div>
                        break;

                    case "status":
                        @* The ten stages from slide 5, each coloured by its status, then
                           the same stages grouped into Built, Partly built and Stub. *@
                        <h1 class="present__title present__title--compact">@s.Title</h1>
                        <p class="present__lead present__lead--compact">@s.Lead</p>
                        <ol class="present__statusLine" style="--stages:@s.Rows.Count">
                            @for (var i = 0; i < s.Rows.Count; i++)
                            {
                                var row = s.Rows[i];
                                <li class="is-@row.Status">
                                    <span class="present__statusDot">@(i + 1)</span>
                                    <span class="present__statusName">@row.Name</span>
                                </li>
                            }
                        </ol>
                        <div class="present__statusCols">
                            @foreach (var status in new[] { "built", "partial", "stub" })
                            {
                                var group = s.Rows.Select((r, i) => (Row: r, Number: i + 1)).Where(x => x.Row.Status == status).ToList();
                                <div class="present__statusCol">
                                    <p class="present__statusHead is-@status">@StatusIcon(status) @StatusLabel(status) <span>@group.Count</span></p>
                                    <ul>
                                        @foreach (var (row, number) in group)
                                        {
                                            <li><strong>@number. @row.Name</strong> <span>@row.Text</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        break;

                    case "showwork":
                        <h1 class="present__title">@s.Title</h1>
                        <p class="present__lead">@s.Lead</p>
                        <div class="present__split">
                            @* The real "show the work" panel (Components/Shared/ShowTheWork.razor), fed sample steps
                               built from the stage contract's test questions 2 and 4, so it looks exactly like the chat. *@
                            <div class="present__work">
                                <ShowTheWork Steps="_sampleAnswered" TotalMs="@(_sampleAnswered.Sum(x => x.ElapsedMs))" StartOpen="true" />
                                <ShowTheWork Steps="_sampleHandoff" TotalMs="@(_sampleHandoff.Sum(x => x.ElapsedMs))" />
                            </div>
                            <ul class="present__bullets">
                                @foreach (var b in s.Bullets) { <li>@b</li> }
                            </ul>
                        </div>
                        break;

                    case "list":
                        <h1 class="present__title">@s.Title</h1>
                        <p class="present__lead">@s.Lead</p>
                        <ul class="present__rows">
                            @foreach (var item in s.Items)
                            {
                                <li><strong>@item.Title</strong> <span>@item.Text</span></li>
                            }
                        </ul>
                        break;

                    case "demo":
                        <div class="present__demo">
                            <h1 class="present__title">@s.Title</h1>
                            <p class="present__lead">@s.Lead</p>
                            <ol class="present__demoSteps">
                                @foreach (var step in s.Steps) { <li>@step</li> }
                            </ol>
                        </div>
                        break;

                    case "numbered":
                        <h1 class="present__title present__title--compact">@s.Title</h1>
                        <p class="present__lead present__lead--compact">@s.Lead</p>
                        <ol class="present__numbered">
                            @for (var i = 0; i < s.Items.Count; i++)
                            {
                                var item = s.Items[i];
                                <li>
                                    <span class="present__numberedNum">@(i + 1)</span>
                                    <span><strong>@item.Title</strong><span>@item.Text</span></span>
                                </li>
                            }
                        </ol>
                        break;

                    case "features":
                        <h1 class="present__title">@s.Title</h1>
                        <div class="present__groups">
                            @foreach (var g in s.Groups)
                            {
                                <div class="present__group">
                                    <p class="present__groupLabel">@g.Label</p>
                                    <ul class="present__rows present__rows--small">
                                        @foreach (var item in g.Items)
                                        {
                                            <li><strong>@item.Title</strong> <span>@item.Text</span></li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        break;

                    default:
                        <h1 class="present__title">@s.Title</h1>
                        <p class="present__lead present__lead--big">@s.Lead</p>
                        <ul class="present__bullets">
                            @foreach (var b in s.Bullets) { <li>@b</li> }
                        </ul>
                        break;
                }
            </div>

            @* Footer, bottom left. The bottom-right corner stays empty for Isa's chat bubble. *@
            <div class="present__footer">
                <button type="button" class="present__nav" @onclick="@(() => Go(-1))" disabled="@(_index == 0)" aria-label="Previous slide">&#8249;</button>
                <span class="present__count" aria-live="polite">@(_index + 1) / @_slides.Count</span>
                <button type="button" class="present__nav" @onclick="@(() => Go(1))" disabled="@(_index == _slides.Count - 1)" aria-label="Next slide">&#8250;</button>
                @if (!string.IsNullOrEmpty(s.Presenter))
                {
                    <span class="present__presenter">@s.Presenter</span>
                }
            </div>
        </div>
    </div>
}

@code {
    // The approved ISACA C (BRAND_GUIDELINES.md, section 3), drawn as a fill.
    private const string CPath = "M153.26 74.88L193.32 74.88A3.33 3.33 0 0 0 196.5 70.58A100.89 100.89 0 1 0 196.5 129.42A3.33 3.33 0 0 0 193.32 125.12L153.26 125.12A3.33 3.33 0 0 0 150.32 126.88A57.05 57.05 0 1 1 150.32 73.12A3.33 3.33 0 0 0 153.26 74.88Z";

    // The turns in ISACA's graphic strip (brand.isaca.org/visual-style), in
    // degrees clockwise from the approved C's right-facing opening: up,
    // down-left, right.
    private static readonly int[] StripTurns = [270, 135, 0];

    // Presentation set-up (runs once when the page opens). Settings is app-wide and in memory,
    // so a fresh start of Isa puts both back.
    private const int PresentationStepMs = 500;   // each stage stays on screen at least this long
    private bool _warmed;

    // Alt+1 to Alt+5 type these into Isa's question box (the demo's test questions 1 to 5).
    private static readonly string[] DemoQuestions =
        IsaChatApp.Services.ShowTheWork.MockStageFeed.Cases.Take(5).Select(c => c.Question).ToArray();

    // The opening screen. Stays until the next-slide key is pressed, then fades and the intro plays.
    private enum Gate { Off, Checking, Ready, NotReady }
    private Gate _gate = Gate.Off;
    private bool _gateLeaving;
    private string? _frameUrl;
    private bool _casesOpen;
    private SalesforceTicketService.CaseList? _cases;
    private DateTime? _casesUpdated;
    private CancellationTokenSource? _casesCts;

    private bool _outro;                 // the closing animation is showing (Back takes it away)
    private List<string> _gateProblems = [];
    private CancellationTokenSource? _gateCts;                         // the model warm-up is sent once per visit

    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    // Sample runs for the "Show the work" slide: made by the same feed the panel's tests use,
    // so the wording comes from the real WorkStepText, not from the slide file.
    private readonly IReadOnlyList<IsaChatApp.Services.Orchestrator.WorkStep> _sampleAnswered = SampleSteps(2, null);
    private readonly IReadOnlyList<IsaChatApp.Services.Orchestrator.WorkStep> _sampleHandoff = SampleSteps(4, "TKT-4817");

    private static IReadOnlyList<IsaChatApp.Services.Orchestrator.WorkStep> SampleSteps(int testQuestion, string? ticket)
    {
        var state = new IsaChatApp.Services.ShowTheWork.StageFeedState();
        foreach (var update in IsaChatApp.Services.ShowTheWork.MockStageFeed.Script(testQuestion)) state.Apply(update);
        return state.Finished
            .Select(step => ticket is null ? step : step with { DataText = step.DataText.Replace("TKT-0001", ticket) })
            .ToList();
    }

    private IReadOnlyList<Slide> _slides = [];
    private string? _error;
    private int _index;
    private bool _introPending = true;   // until JS has decided whether the intro plays
    private IJSObjectReference? _js;
    private DotNetObjectReference<Present>? _self;

    protected override void OnInitialized() => (_slides, _error) = Deck.Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Settings.PresentationEnabled || _slides.Count == 0) return;
        _self = DotNetObjectReference.Create(this);
        _js = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Present.razor.js?v=" + DateTime.UtcNow.Ticks);   // new address each load, so a browser never serves an old copy
        ApplyPresentationSetup();
        var start = await _js.InvokeAsync<int>("init", _self, DemoQuestions);
        // The opening screen and the intro happen only when the slides open on the first
        // slide, so a refresh in the middle of the talk skips both (I replays the intro).
        if (start == 0)
        {
            _gate = Gate.Checking;   // the dark cover stays until the screen is dismissed
            StateHasChanged();
            _ = RunGateAsync();
            return;
        }
        _ = RunReadinessCheckAsync();
        await GoTo(start);
        _introPending = false;
        StateHasChanged();
    }

    [JSInvokable]
    public Task Go(int delta)
    {
        if (_gate != Gate.Off)
        {
            if (delta > 0) _ = LeaveGateAsync();   // forward leaves the opening screen; back does nothing
            return Task.CompletedTask;
        }
        if (_outro)
        {
            if (delta < 0) return EndOutroAsync();   // Back leaves the closing; forward does nothing
            return Task.CompletedTask;
        }
        // Back on the first slide returns to the opening screen (Ready), so the intro can play again.
        if (delta < 0 && _index == 0)
        {
            ResetToStart();
            return Task.CompletedTask;
        }
        // Forward on the last slide plays the closing.
        if (delta > 0 && _index == _slides.Count - 1 && _js is not null)
        {
            _outro = true;
            return _js.InvokeVoidAsync("playOutro").AsTask();
        }
        return GoTo(_index + delta);
    }

    // Alt+C: show or hide the live Cases panel (not over the opening screen or the closing).
    [JSInvokable]
    public async Task ToggleCases()
    {
        if (_gate != Gate.Off || _outro) return;
        if (_casesOpen) { await CloseCases(); return; }
        await CloseFrame();
        _casesOpen = true;
        _cases = null;
        _casesUpdated = null;
        _casesCts = new CancellationTokenSource();
        _ = PollCasesAsync(_casesCts.Token);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CloseCases()
    {
        if (!_casesOpen) return;
        _casesOpen = false;
        _casesCts?.Cancel();
        await InvokeAsync(StateHasChanged);
    }

    // Alt+6 / Alt+7: a dashboard over the slides. The slide, the chat and its sign-in are untouched underneath.
    [JSInvokable]
    public async Task ToggleFrame(string path)
    {
        if (_gate != Gate.Off || _outro) return;
        var url = path + "?embed=1";   // ?embed=1: no second Isa inside the frame
        if (_frameUrl == url) { await CloseFrame(); return; }
        await CloseCases();
        _frameUrl = url;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task CloseFrame()
    {
        if (_frameUrl is null) return;
        _frameUrl = null;
        await InvokeAsync(StateHasChanged);
        if (_js is not null) await _js.InvokeVoidAsync("refocus");
    }

    private async Task PollCasesAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                _cases = await Salesforce.ListRecentCasesAsync(6, ct);
                _casesUpdated = DateTime.Now;
                await InvokeAsync(StateHasChanged);
                if (_js is not null) await _js.InvokeVoidAsync("fitCases");
                await Task.Delay(3000, ct);
            }
        }
        catch (OperationCanceledException) { }
    }

    private static string CasesError(string? error) => error switch
    {
        "off" => "The Salesforce connection is switched off (Ticketing:Salesforce:Enabled).",
        "not_configured" => "Salesforce is not configured on the Dev Dashboard.",
        "http_403" or "http_401" => $"Salesforce refused the read ({error}). The Isa login needs permission to read Cases.",
        _ => $"Could not read Cases from Salesforce ({error})."
    };

    private void ResetToStart()
    {
        _introPending = true;       // the dark cover comes back over the first slide
        _gateLeaving = false;
        _gate = Gate.Checking;      // the same check as when the page opened, then Ready
        _ = InvokeAsync(StateHasChanged);
        _ = RunGateAsync();
    }

    private async Task EndOutroAsync()
    {
        _outro = false;
        if (_js is not null) await _js.InvokeVoidAsync("stopOutro");
    }

    [JSInvokable]
    public async Task GoTo(int index)
    {
        if (_gate != Gate.Off) return;
        if (_outro) await EndOutroAsync();
        var next = Math.Clamp(index, 0, _slides.Count - 1);
        if (next == _index && _js is not null) return;
        _index = next;
        if (_slides[_index].Warmup && !_warmed)
        {
            _warmed = true;
            _ = Task.Run(async () => { await Ollama.WarmAsync(); });   // background; a failure changes nothing on screen
        }
        await InvokeAsync(StateHasChanged);
        if (_js is not null) await _js.InvokeVoidAsync("setSlide", _index);
    }

    // Slows the "show the work" steps for the audience and gives this session the Executive
    // role (Developer Dashboard + Content Health in Backstage). Signing in stays manual.
    private void ApplyPresentationSetup()
    {
        Settings.MinStageMs = PresentationStepMs;
        Settings.CurrentRole = WidgetSettings.UserRole.Executive;
    }

    // Quiet readiness check: nothing on the slides. The result goes to the browser console
    // ("[Isa ready]") and is kept in _ready for the indicator.
    private ReadyReport? _ready;

    private async Task<ReadyReport?> RunReadinessCheckAsync()
    {
        try
        {
            var model = await Ollama.StatusAsync();
            var dev = await DevAccess.HasDevRoleAsync(AuthState);
            var sf = await Salesforce.CheckAsync();
            _ready = new ReadyReport(model.Reachable, model.ModelInstalled, model.ModelLoaded, dev, sf, Settings.MinStageMs, Settings.CurrentRole.ToString());
            if (_js is not null) await _js.InvokeVoidAsync("reportReady", _ready);
            return _ready;
        }
        catch { return null; /* the check must never break the slides */ }
    }

    // Runs the check every 3 seconds until everything is ready, so signing in or starting Ollama
    // turns the screen to Ready by itself.
    private async Task RunGateAsync()
    {
        _gateCts = new CancellationTokenSource();
        var ct = _gateCts.Token;
        try
        {
            while (!ct.IsCancellationRequested)
            {
                ApplyGate(await RunReadinessCheckAsync());
                await InvokeAsync(StateHasChanged);
                if (_gate == Gate.Ready) return;
                await Task.Delay(3000, ct);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void ApplyGate(ReadyReport? r)
    {
        var problems = new List<string>();
        if (r is null) problems.Add("The check could not run");
        else
        {
            if (!r.OllamaReachable) problems.Add("Ollama is not running");
            else if (!r.ModelInstalled) problems.Add("The model is not installed");
            if (!r.SignedInAsDev) problems.Add("Not signed in with the developer role");
            if (r.Salesforce is not ("ok" or "off")) problems.Add(r.Salesforce == "not_configured" ? "Salesforce is not configured" : $"Salesforce: {r.Salesforce}");
        }
        _gateProblems = problems;
        _gate = problems.Count == 0 ? Gate.Ready : Gate.NotReady;
    }

    // The next-slide key: "Ready" fades, then the intro plays and the first slide opens under it.
    private async Task LeaveGateAsync()
    {
        if (_gateLeaving) return;
        _gateLeaving = true;
        _gateCts?.Cancel();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(600);
        if (_js is not null) await _js.InvokeVoidAsync("playIntro");
        _gate = Gate.Off;
        _gateLeaving = false;
        _introPending = false;
        await InvokeAsync(StateHasChanged);
    }

    private sealed record ReadyReport(bool OllamaReachable, bool ModelInstalled, bool ModelLoaded, bool SignedInAsDev, string Salesforce, int StepMs, string Role);

    // "Meet Isa": the last word ("Isa") is shown in ISACA Green.
    private static (string Start, string Name) SplitLastWord(string title)
    {
        var cut = title.LastIndexOf(' ');
        return cut < 0 ? ("", title) : (title[..(cut + 1)], title[(cut + 1)..]);
    }

    // A lead with words between *asterisks*: those words in italics and colour
    // (present__em). Every other part is plain text, so nothing is read as HTML.
    private RenderFragment Emphasised(string? text) => __builder =>
    {
        var parts = (text ?? "").Split('*');
        for (var i = 0; i < parts.Length; i++)
        {
            if (i % 2 == 1)
            {
                <em class="present__em">@parts[i]</em>
            }
            else
            {
                @parts[i]
            }
        }
    };

    private static string StatusLabel(string? status) => status switch
    {
        "built" => "Built",
        "partial" => "Partly built",
        "stub" => "Stub",
        _ => status ?? ""
    };

    // Each status has its own symbol, so color never carries the meaning alone.
    private static string StatusIcon(string? status) => status switch
    {
        "built" => "✓",
        "partial" => "◐",
        "stub" => "○",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_js is not null)
            {
                await _js.InvokeVoidAsync("dispose");
                await _js.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        _gateCts?.Cancel();
        _casesCts?.Cancel();
        _self?.Dispose();
    }
}
