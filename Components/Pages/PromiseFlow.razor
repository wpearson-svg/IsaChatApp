@code {
    /// <summary>False: the opening diagram with the moving dot. True: the closing slide, where it transforms into the status rail.</summary>
    [Parameter] public bool Kept { get; set; }
    /// <summary>The slide's items (name, title, status, built), used for the status rail.</summary>
    [Parameter] public List<SlideItem> Items { get; set; } = [];
    /// <summary>True on a Dark Blue slide.</summary>
    [Parameter] public bool Dark { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _js;
    private bool _rendered;

    // The picture is drawn once; the script moves it. A later render of the page must not touch it.
    protected override bool ShouldRender() => !_rendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _rendered = true;
        _js = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/PromiseFlow.razor.js?v=" + DateTime.UtcNow.Ticks);
        var items = Items.Select(i => new { name = i.Name, title = i.Title, text = i.Text, status = i.Status, built = i.Built }).ToList();
        await _js.InvokeVoidAsync("mount", _root, Kept, Dark, items);
    }

    public async ValueTask DisposeAsync()
    {
        if (_js is null) return;
        try
        {
            await _js.InvokeVoidAsync("unmount");
            await _js.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
}
