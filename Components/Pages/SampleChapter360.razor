        else
        {
            <div class="c3-pas">
                @foreach (var pa in a.PracticeAreas)
                {
                    var open = _openPractices.Contains(pa.Number);
                    var seen = _explored.TryGetValue(a.Code, out var ex) && ex.Contains($"pa:{pa.Number}");
                    var id = $"c3-pa-{a.Code}-{pa.Number}";
                    @if (pa.Number == OpenPractice)
