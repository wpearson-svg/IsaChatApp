    private string ScoreText(C360FocusArea a, int number)
    {
        var i = a.PracticeAreas.FindIndex(p => p.Number == number);
        return i >= 0 && PaScore(a, i) is double v ? $" · chapter score {L(v)} of 5" : "";
    }

    // =====================================================================
    // All six Focus Areas
