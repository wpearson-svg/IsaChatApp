    private RenderFragment AreasView() => @<text>
        <div class="c3-pageHead">
            <h1>Focus Areas</h1>
            <p class="c3-lede">
                The Chapter 360 tool comprises six key Focus Areas, and within each Focus Area, there are three to six Practice Areas.
            </p>
        </div>
        <div class="c3-areas c3-areas--wide">
            @foreach (var a in Areas)
