    // =====================================================================
    // Tools & templates
    // =====================================================================

    private string _search = "";
    private string _typeFilter = "All";

    private record ToolRow(C360FocusArea Area, C360Practice Practice, C360Tool Tool, string Kind);

    // Kinds shown as filters; anything else is "Other".
    private static readonly string[] Kinds = { "Template", "List", "Task Checklist", "Presentation", "Report", "Website Link" };

    private static string KindOf(C360Tool t)
    {
        var k = System.Text.RegularExpressions.Regex.Replace(t.Type, @"\s*\(.*\)$", "").Trim();
        if (k.EndsWith('s') && Kinds.Contains(k[..^1])) k = k[..^1];
        if (k == "Weblink" || k == "Link") k = "Website Link";
        return Kinds.Contains(k) ? k : "Other";
    }

    private List<ToolRow> AllTools() => Areas
        .SelectMany(a => a.PracticeAreas.SelectMany(pa => pa.Practices.SelectMany(pr =>
            pr.Tools.Where(t => !t.IsTbd).Select(t => new ToolRow(a, pr, t, KindOf(t))))))
        .DistinctBy(r => (r.Area.Code, r.Tool.Type, r.Tool.Name))
        .ToList();

    private RenderFragment ToolsView()
    {
        var all = AllTools();
        var shown = all
            .Where(r => _typeFilter == "All" || r.Kind == _typeFilter)
            .Where(r => _search.Length == 0 || r.Tool.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                        || r.Practice.Title.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
        return @<text>
            <div class="c3-pageHead">
                <h1>Tools &amp; templates</h1>
                <p class="c3-lede">Every tool, template and resource named in the six Focus Areas, @all.Count in all.</p>
            </div>
            <div class="c3-toolbar">
                <label class="c3-search">
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5L14 14" stroke-linecap="round" /></svg>
                    <span class="c3-visually-hidden">Search tools and templates</span>
                    <input type="search" placeholder="Search, for example budget or volunteer" @bind="_search" @bind:event="oninput" />
                </label>
                <div class="c3-filters" role="group" aria-label="Kind of resource">
                    @foreach (var k in new[] { "All" }.Concat(Kinds).Append("Other"))
                    {
                        var count = k == "All" ? all.Count : all.Count(r => r.Kind == k);
                        if (count == 0) continue;
                        <button type="button" class="@(_typeFilter == k ? "is-on" : "")" aria-pressed="@(_typeFilter == k ? "true" : "false")"
                                @onclick="@(() => _typeFilter = k)">@k <span>@count</span></button>
                    }
                </div>
            </div>
            @if (shown.Count == 0)
            {
                <p class="c3-empty">Nothing matches "@_search". Try a shorter word.</p>
            }
            @foreach (var group in shown.GroupBy(r => r.Area))
            {
                <section class="c3-toolGroup" style="--c: @ColorOf(group.Key.Code)">
                    <h2><span class="c3-code">@group.Key.Code</span> @group.Key.Name <small>@group.Count()</small></h2>
                    <ul class="c3-toolList">
                        @foreach (var r in group)
                        {
                            <li>
                                <button type="button" @onclick="@(() => NotInPrototype(r.Tool.Name))">
                                    <span class="c3-toolList__kind">@(r.Tool.Type.Length > 0 ? r.Tool.Type : "Resource")</span>
                                    <span class="c3-toolList__name">@r.Tool.Name</span>
                                    <span class="c3-toolList__where">@r.Practice.Number @r.Practice.Title</span>
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            }
        </text>;
    }

    // =====================================================================
    // Self-assessment: the leader adds their own rating of the chapter
    // =====================================================================

    private string? _assessCode;
    private string? _justSaved;

    private RenderFragment AssessView()
    {
        var a = C360.GetArea(_assessCode) ?? C360.GetArea(NextToRate()) ?? Areas.FirstOrDefault();
        if (a is null) return @<p class="c3-empty">The Chapter 360 documents aren't loaded.</p>;
        var mine = Mine(a);
        var done = mine.All(s => s is not null);
        var myAvg = mine.Any(s => s is not null) ? mine.Where(s => s is not null).Average(s => (double)s!.Value) : (double?)null;
        var withMine = Level(a, draft: true);
        var ratersAfter = (BoardAverage.ContainsKey(a.Code) ? BoardRaters : 0) + 1;
        return @<text>
            <div class="c3-pageHead">
                <h1>Your rating of the chapter</h1>
                <p class="c3-lede">
                    Each board member rates the chapter on their own, and Chapter 360 averages everyone's ratings
                    into the chapter's score. Each practice area is assessed on a scale of 1 to 5.
                </p>
            </div>
            <div class="c3-assessTabs" role="tablist" aria-label="Focus Areas">
                @foreach (var f in Areas)
                {
                    var on = f.Code == a.Code;
                    <button type="button" role="tab" aria-selected="@(on ? "true" : "false")" class="@(on ? "is-on" : "")" style="--c: @ColorOf(f.Code)"
                            @onclick="@(() => { _assessCode = f.Code; _justSaved = null; })">
                        <span class="c3-code">@f.Code</span>
                        <span class="c3-assessTabs__name">@f.Name</span>
                        <span class="c3-assessTabs__state">@(_myRated.Contains(f.Code) ? "✓ You rated it" : BoardAverage.ContainsKey(f.Code) ? $"Rated by {BoardRaters} · you: to do" : "Nobody yet · you: to do")</span>
                    </button>
                }
            </div>

            <div class="c3-assess">
                <section class="c3-assess__form" style="--c: @ColorOf(a.Code)" aria-labelledby="c3-assess-title">
                    <h2 id="c3-assess-title"><span class="c3-code">@a.Code</span> @a.Name</h2>
                    <p class="c3-assess__hint">How well do you think Sakura Bay Chapter does each of these today? 1 is the lowest, 5 the highest. Your own scores stay private; only the average is shared.</p>
                    <ol class="c3-rates">
                        @for (var i = 0; i < a.PracticeAreas.Count; i++)
                        {
                            var index = i;
                            var pa = a.PracticeAreas[i];
                            var board = BoardPa(a, i);
                            <li class="c3-rate">
                                <div class="c3-rate__text">
                                    <b>@pa.Name</b>
                                    @if (pa.WhatItIs.Length > 0)
                                    {
                                        <small>@FirstSentence(pa.WhatItIs)</small>
                                    }
                                    <small class="c3-rate__board">@(board is double bv ? $"Board average so far: {L(bv)}" : "No ratings yet")</small>
                                </div>
                                <div class="c3-rate__scale" role="radiogroup" aria-label="@($"{pa.Name}, 1 to 5")">
                                    @for (var n = 1; n <= 5; n++)
                                    {
                                        var value = n;
                                        var on = mine[index] == value;
                                        <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" class="@(on ? "is-on" : "") @(mine[index] >= value ? "is-filled" : "")"
                                                @onclick="@(() => { mine[index] = value; _justSaved = null; })">@value</button>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                    <div class="c3-assess__foot">
                        <span class="c3-assess__score">
                            @if (myAvg is double v)
                            {
                                <text>Your score: <b>@L(v)</b> · chapter with yours: <b>@(withMine is double w ? L(w) : "–")</b> of 5 <small>(@ratersAfter rating@(ratersAfter == 1 ? "" : "s"))</small></text>
                            }
                            else
                            {
                                <text>Rate each Practice Area to see your score.</text>
                            }
                        </span>
                        <button type="button" class="c3-btn c3-btn--primary" disabled="@(!done)" @onclick="@(() => AddRating(a))">
                            @(_myRated.Contains(a.Code) ? "Update your rating" : "Add your rating")
                        </button>
                    </div>
                    @if (_justSaved == a.Code)
                    {
                        <div class="c3-saved" role="status">
                            <span>Added to the chapter's 360 view, now from @Raters(a) rating@(Raters(a) == 1 ? "" : "s"). Saved for this demo only: reloading the page starts over.</span>
                            @if (NextToRate() is string next)
                            {
                                <button type="button" class="c3-area__link" @onclick="@(() => { _assessCode = next; _justSaved = null; })">Next: @C360.GetArea(next)?.Name <span aria-hidden="true">→</span></button>
                            }
                            else
                            {
                                <button type="button" class="c3-area__link" @onclick="@(() => Go("overview"))">See your chapter's 360 view <span aria-hidden="true">→</span></button>
                            }
                        </div>
                    }
                </section>
                <aside class="c3-assess__side">
                    @Radar(inAssess: true, draftCode: a.Code)
                    @Progress()
                </aside>
            </div>
        </text>;
    }

    private void AddRating(C360FocusArea a)
    {
        _myRated.Add(a.Code);
        _justSaved = a.Code;
        _lastUpdated = $"{Settings.Today.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)} by Watanabe Kenji";
    }

    private static string FirstSentence(string text)
    {
        var i = text.IndexOf(". ", StringComparison.Ordinal);
        return i > 0 ? text[..(i + 1)] : text;
    }

    // =====================================================================
    // Help: ISACA's Chapter 360 introduction
    // =====================================================================

    private RenderFragment HelpView() => @<text>
        <div class="c3-pageHead">
            <h1>How Chapter 360 works</h1>
            <p class="c3-lede">ISACA's introduction to Chapter 360, word for word. Read it here, or press play to listen.</p>
        </div>
        @Reader("c360-intro", "the introduction")
    </text>;

    // =====================================================================
    // Read & listen: the Library's player and text, for one document.
    // The buttons and highlighting are worked by LibraryPanel.razor.js.
    // =====================================================================

    private ElementReference _readerRef;
    private IJSObjectReference? _js;     // the Library's reader
    private IJSObjectReference? _page;   // this page's scrolling (SampleChapter360.razor.js)
    private string? _attachedDoc;

    private RenderFragment Reader(string docId, string name)
    {
        var text = Library.GetText(docId);
        if (text is null) return @<p class="c3-empty">This document isn't loaded yet.</p>;
        return @<div class="c3-reader" @key="docId" @ref="_readerRef">
            <div class="c3-player" data-lib-player>
                <button type="button" class="c3-pbtn" data-lib="prev" title="Back a section" aria-label="Back a section">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"><path d="M3 2h2v12H3zM14 2v12L6 8z" /></svg>
                </button>
                <button type="button" class="c3-pbtn c3-pbtn--main" data-lib="toggle" title="Listen" aria-label="Listen">
                    <svg class="c3-iconPlay" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M4 2l10 6-10 6z" /></svg>
                    <svg class="c3-iconPause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M3 2h3.5v12H3zM9.5 2H13v12H9.5z" /></svg>
                </button>
                <button type="button" class="c3-pbtn" data-lib="next" title="Forward a section" aria-label="Forward a section">
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor"><path d="M11 2h2v12h-2zM2 2v12l8-6z" /></svg>
                </button>
                <div class="c3-track">
                    <span class="c3-status" data-lib-status aria-live="polite">Press play to listen to @name</span>
                    <span class="c3-bar"><span data-lib-bar></span></span>
                </div>
                <button type="button" class="c3-speed" data-lib="speed" title="Reading speed" aria-label="Reading speed, 1 times">1&times;</button>
            </div>
            <p class="c3-reader__meta">Read word for word in Isa's own voice · about @text.Document.Minutes minutes · also in Isa's Listen Library</p>
            <div class="c3-text" data-lib-text data-doc="@docId">
                @foreach (var section in text.Sections)
                {
                    @if (section.Heading is not null)
                    {
                        <h3 class="c3-text__sec"><span class="c3-s" data-i="@section.HeadingIndex" data-section>@section.Heading</span></h3>
                    }
                    @foreach (var para in section.Paragraphs)
                    {
                        <p class="c3-text__para @(para.Bullet ? "is-bullet" : "")" data-section="@(section.Heading is null && para == section.Paragraphs[0] ? "" : null)">
                            @foreach (var s in para.Sentences)
                            {
                                <span class="c3-s" data-i="@s.Index">@s.Text</span>
                                @(" ")
                            }
                        </p>
                    }
                }
            </div>
        </div>;
    }

    private bool ReaderShown => _readTab && (CurrentView == "help" || (CurrentView == "area" && ShownArea is not null));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollTop)
        {
            _scrollTop = false;
            try
            {
                _page ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/SampleChapter360.razor.js");
                if (OpenPractice is not null && CurrentView == "area" && !_readTab && _linkedPa.Context is not null)
                    await _page.InvokeVoidAsync("scrollToElement", _linkedPa);   // the linked Practice Area
                else
                    await _page.InvokeVoidAsync("scrollToTop");
            }
            catch (JSException) { }   // scrolling is a nicety: never let it break the page
        }
        if (!ReaderShown)
        {
            if (_attachedDoc is not null) await StopReading();
            return;
        }
        var doc = CurrentView == "help" ? "c360-intro" : "c360-" + ShownArea!.Code.ToLowerInvariant();
        _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/LibraryPanel.razor.js");
        if (_attachedDoc != doc || _autoplay)
        {
            await _js.InvokeVoidAsync("attach", _readerRef, _autoplay);
            _attachedDoc = doc;
            _autoplay = false;
        }
    }

    private async Task StopReading()
    {
        _attachedDoc = null;
        try { if (_js is not null) await _js.InvokeVoidAsync("stop"); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await StopReading();
        try
        {
            if (_js is not null) await _js.DisposeAsync();
            if (_page is not null) await _page.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
