    private RenderFragment HomeView() => @<text>
        @* ---- The announcement: Isa is live ---- *@
        <section class="eg-isa" aria-labelledby="eg-isa-title">
            <div class="eg-confetti" aria-hidden="true">
                @for (var i = 0; i < 18; i++)
                {
                    <i style="--i: @i"></i>
