        new("Jul", "16", "CPE Evening: Auditing cloud services", "Thu 18:30 JST · Hybrid, Tokyo", "2 CPE"),
        new("Jul", "23", "New member welcome", "Thu 19:00 JST · Online", null),
        new("Aug", "06", "CISA study group: kickoff", "Thu 19:30 JST · Online", "1 CPE"),
