@page "/sample/engage"
@layout AuthLayout
@rendermode InteractiveServer
@using System.Globalization
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ============================================================
   SampleEngage.razor

   The sample Engage page, opened in a new tab by the Engage button on
   Isa's rail (IsaRail.razor). A chapter's Engage community is behind
   ISACA's login, so the prototype shows this look-alike instead
   (Matthew, 27 October 2026: "they don't need to function, but they
   should look really good", with a fun announcement that Isa is live
   for every chapter member).

   28 October 2026 (Matthew): parts now work, like the Chapter 360 page,
   so it looks real in the presentation:
   - Home: the Isa announcement (its example conversation steps through
     two real questions Isa answers from ISACA's text, and "What can Isa
     do?" opens a short, honest list), latest discussions, library,
     events, leaders and numbers. "Post a message" and "Following" work.
   - Discussion: every thread, filters, search, and "New discussion".
     A thread opens with its replies; you can like it and reply.
   - Library: folders and files (opening a file shows a sample note).
   - Events: each event opens; Register and Add to calendar respond.
   - Members: the members who chose to be listed, searchable.
   Anything typed stays on this page until it is reloaded: nothing is
   saved or sent, and none of it goes through Isa.

   Modelled on the layout of ISACA's public Engage pages and on how a
   chapter community page is usually arranged. Every person, post,
   reply, event, file and number is invented (the leaders are the
   prototype's sample Sakura Bay board). The Isa example answers are
   ISACA's own words from Isa's approved content, and the announcement
   only claims what Isa really does.

   Honest by design: a ribbon says it is a sample and nothing is saved;
   there are no sign-in fields and no ISACA logo.
   ============================================================ *@

<PageTitle>Engage (sample) · Sakura Bay Chapter</PageTitle>

<div class="eg">
    <div class="eg-ribbon" role="note">
        <strong>Sample page</strong> for the Isa prototype · not ISACA's real Engage site · some parts work, nothing is saved
    </div>

    <header class="eg-top">
        <div class="eg-top__inner">
            <button type="button" class="eg-brand" aria-label="Engage (sample): community home" @onclick="@(() => Go("home"))">
                <svg class="eg-brand__mark" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="10" cy="12" r="5" fill="#017dc2" />
                    <circle cx="30" cy="10" r="4" fill="#36ac91" />
                    <circle cx="28" cy="29" r="5.5" fill="#1d2d5c" />
                    <circle cx="11" cy="30" r="3.5" fill="#6cb33f" />
                    <path d="M10 12L30 10M30 10L28 29M28 29L11 30M11 30L10 12M10 12L28 29" stroke="#9fb3c8" stroke-width="1.4" />
                </svg>
                <span class="eg-brand__name">Engage</span>
            </button>
            <nav class="eg-nav" aria-label="Engage sections">
                <button type="button" @onclick="@(() => Go("home"))">Home</button>
                <button type="button" @onclick="@(() => ElsewhereInEngage("Connect"))">Connect <span aria-hidden="true">▾</span></button>
                <button type="button" class="is-on">Communities <span aria-hidden="true">▾</span></button>
                <button type="button" @onclick="@(() => Go("events"))">Events <span aria-hidden="true">▾</span></button>
                <button type="button" @onclick="@(() => ElsewhereInEngage("Volunteer"))">Volunteer <span aria-hidden="true">▾</span></button>
            </nav>
            <form class="eg-search" role="search" @onsubmit="SearchEngage">
                <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <label class="eg-visually-hidden" for="eg-search-box">Search discussions</label>
                <input id="eg-search-box" type="search" placeholder="Search discussions" @bind="_topSearch" @bind:event="oninput" />
            </form>
            <span class="eg-avatar" aria-label="Signed in as Watanabe Kenji">WK</span>
        </div>
    </header>

    @* ---- Community banner ---- *@
    <section class="eg-banner">
        <svg class="eg-banner__art" viewBox="0 0 600 260" aria-hidden="true" preserveAspectRatio="xMaxYMid slice">
            <g fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="1.2">
                <circle cx="470" cy="130" r="150" />
                <ellipse cx="470" cy="130" rx="150" ry="60" />
                <ellipse cx="470" cy="130" rx="60" ry="150" />
                <ellipse cx="470" cy="130" rx="110" ry="150" />
                <path d="M320 130h300M470 -20v300" />
            </g>
            <g fill="#ffffff">
                <circle cx="395" cy="70" r="3.5" opacity=".9" />
                <circle cx="520" cy="55" r="2.5" opacity=".7" />
                <circle cx="560" cy="150" r="3" opacity=".8" />
                <circle cx="430" cy="200" r="2.5" opacity=".7" />
                <circle cx="480" cy="120" r="4" />
            </g>
            <path d="M395 70L480 120L520 55M480 120L560 150M480 120L430 200" stroke="rgba(255,255,255,0.45)" stroke-width="1.2" fill="none" />
        </svg>
        <div class="eg-banner__inner">
            <p class="eg-kicker">Chapter community · Asia-Pacific</p>
            <h1>Sakura Bay Chapter</h1>
            <p class="eg-banner__sub">@MemberCount members · Tokyo and online · Connecting digital trust professionals around the bay since 2009</p>
            <div class="eg-banner__btns">
                <button type="button" class="eg-btn eg-btn--light" @onclick="StartPost">Post a message</button>
                <button type="button" class="eg-btn eg-btn--outline" aria-pressed="@(_following ? "true" : "false")" @onclick="ToggleFollow">
                    @(_following ? "✓ Following" : "+ Follow")
                </button>
            </div>
        </div>
    </section>

    <nav class="eg-tabs" aria-label="Community pages">
        <div class="eg-tabs__inner">
            @foreach (var (key, label) in TabItems)
            {
                <button type="button" class="@(CurrentTab == key ? "is-on" : "")" aria-current="@(CurrentTab == key ? "page" : null)"
                        @onclick="@(() => Go(key))">@label</button>
            }
        </div>
    </nav>

    <main class="eg-main">
        @if (ShownPost is not null)
        {
            @ThreadView(ShownPost)
        }
        else if (ShownEvent is not null)
        {
            @EventView(ShownEvent)
        }
        else
        {
            @switch (CurrentTab)
            {
                case "discussion":
                    @DiscussionView()
                    break;
                case "library":
                    @LibraryView()
                    break;
                case "events":
                    @EventsView()
                    break;
                case "members":
                    @MembersView()
                    break;
                default:
                    @HomeView()
                    break;
            }
        }
    </main>

    <footer class="eg-foot">
        <span>Engage · sample page made for the Isa prototype</span>
        <span>Every person, post, event and number on this page is invented</span>
    </footer>

    @if (_toast is not null)
    {
        <div class="eg-toast" role="status" aria-live="polite">
            <span>@_toast</span>
            <button type="button" aria-label="Close" @onclick="@(() => _toast = null)">&times;</button>
        </div>
    }
</div>

@code {
    // =====================================================================
    // Where we are (in the address, so the browser's Back button works)
    // =====================================================================

    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery(Name = "post")] public int? PostId { get; set; }
    [SupplyParameterFromQuery(Name = "event")] public int? EventId { get; set; }

    private string CurrentTab => ShownPost is not null ? "discussion" : ShownEvent is not null ? "events" : string.IsNullOrEmpty(Tab) ? "home" : Tab;
    private Post? ShownPost => PostId is int id ? _posts.FirstOrDefault(p => p.Id == id) : null;
    private Ev? ShownEvent => EventId is int id ? Events.FirstOrDefault(e => e.Id == id) : null;

    private static readonly (string Key, string Label)[] TabItems =
    {
        ("home", "Home"), ("discussion", "Discussion"), ("library", "Library"), ("events", "Events"), ("members", "Members"),
    };

    private void Go(string tab, int? post = null, int? ev = null)
    {
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tab"] = tab == "home" ? null : tab,
            ["post"] = post,
            ["event"] = ev,
        }));
    }

    private string? _shownFor;
    private bool _scrollTop;

    protected override void OnParametersSet()
    {
        var key = $"{Tab}|{PostId}|{EventId}";
        if (key == _shownFor) return;
        _scrollTop = _shownFor is not null;
        _shownFor = key;
        _replyText = "";
    }

    private IJSObjectReference? _page;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollTop) return;
        _scrollTop = false;
        try
        {
            // The same small scrolling script as the Chapter 360 sample page.
            _page ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/SampleChapter360.razor.js");
            await _page.InvokeVoidAsync("scrollToTop");
        }
        catch (JSException) { }   // scrolling is a nicety: never let it break the page
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_page is not null) await _page.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }

    // ---- A small note at the bottom of the screen ----

    private string? _toast;
    private int _toastId;

    private async Task Toast(string text)
    {
        _toast = text;
        var id = ++_toastId;
        StateHasChanged();
        await Task.Delay(4500);
        if (id == _toastId) { _toast = null; StateHasChanged(); }
    }

    private Task ElsewhereInEngage(string where) =>
        Toast($"{where} is part of ISACA's real Engage site. This sample shows the chapter community only.");

