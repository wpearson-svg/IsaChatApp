@page "/sample/engage"
@layout AuthLayout

@* ============================================================
   SampleEngage.razor

   The sample Engage page, opened in a new tab by the Engage button on
   Isa's rail (IsaRail.razor). A chapter's Engage community is behind
   ISACA's login, so the prototype shows this look-alike instead
   (Matthew, 27 October 2026: "they don't need to function, but they
   should look really good", with a fun announcement that Isa is live
   for every chapter member).

   Modelled on the layout of ISACA's public Engage pages (white header,
   section links, a search pill, a teal-to-blue banner, cards) and on
   how a chapter community page is usually arranged: discussions,
   library, events and members. Every person, post, event and number is
   invented (the people are the prototype's sample Sakura Bay board).

   Honest by design: a ribbon at the top says it is a sample, nothing
   on it works, there are no sign-in fields, and it uses no ISACA logo.
   The announcement only claims what Isa really does: answers from
   ISACA's approved guidance, shows where each answer comes from, and
   passes a question to a person when it needs one.
   ============================================================ *@

<PageTitle>Engage (sample) · Sakura Bay Chapter</PageTitle>

<div class="eg">
    <div class="eg-ribbon" role="note">
        <strong>Sample page</strong> for the Isa prototype · not ISACA's real Engage site · links and buttons don't work
    </div>

    <header class="eg-top">
        <div class="eg-top__inner">
            <a class="eg-brand" aria-label="Engage (sample)">
                <svg class="eg-brand__mark" viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="10" cy="12" r="5" fill="#017dc2" />
                    <circle cx="30" cy="10" r="4" fill="#36ac91" />
                    <circle cx="28" cy="29" r="5.5" fill="#1d2d5c" />
                    <circle cx="11" cy="30" r="3.5" fill="#6cb33f" />
                    <path d="M10 12L30 10M30 10L28 29M28 29L11 30M11 30L10 12M10 12L28 29" stroke="#9fb3c8" stroke-width="1.4" />
                </svg>
                <span class="eg-brand__name">Engage</span>
            </a>
            <nav class="eg-nav" aria-label="Engage sections">
                <a>Home</a>
                <a>Connect <span aria-hidden="true">▾</span></a>
                <a class="is-on">Communities <span aria-hidden="true">▾</span></a>
                <a>Events <span aria-hidden="true">▾</span></a>
                <a>Volunteer <span aria-hidden="true">▾</span></a>
            </nav>
            <div class="eg-search" aria-hidden="true">
                <svg viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                <span>Search Engage</span>
            </div>
            <span class="eg-avatar" aria-label="Signed in as Watanabe Kenji">WK</span>
        </div>
    </header>

    @* ---- Community banner ---- *@
    <section class="eg-banner">
        <svg class="eg-banner__art" viewBox="0 0 600 260" aria-hidden="true" preserveAspectRatio="xMaxYMid slice">
            <g fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="1.2">
                <circle cx="470" cy="130" r="150" />
                <ellipse cx="470" cy="130" rx="150" ry="60" />
                <ellipse cx="470" cy="130" rx="60" ry="150" />
                <ellipse cx="470" cy="130" rx="110" ry="150" />
                <path d="M320 130h300M470 -20v300" />
            </g>
            <g fill="#ffffff">
                <circle cx="395" cy="70" r="3.5" opacity=".9" />
                <circle cx="520" cy="55" r="2.5" opacity=".7" />
                <circle cx="560" cy="150" r="3" opacity=".8" />
                <circle cx="430" cy="200" r="2.5" opacity=".7" />
                <circle cx="480" cy="120" r="4" />
            </g>
            <path d="M395 70L480 120L520 55M480 120L560 150M480 120L430 200" stroke="rgba(255,255,255,0.45)" stroke-width="1.2" fill="none" />
        </svg>
        <div class="eg-banner__inner">
            <p class="eg-kicker">Chapter community · Asia-Pacific</p>
            <h1>Sakura Bay Chapter</h1>
            <p class="eg-banner__sub">412 members · Tokyo and online · Connecting digital trust professionals around the bay since 2009</p>
            <div class="eg-banner__btns">
                <a class="eg-btn eg-btn--light">Post a message</a>
                <a class="eg-btn eg-btn--outline">✓ Following</a>
            </div>
        </div>
    </section>

    <nav class="eg-tabs" aria-label="Community pages">
        <div class="eg-tabs__inner">
            <a class="is-on">Home</a>
            <a>Discussion</a>
            <a>Library</a>
            <a>Events</a>
            <a>Members</a>
        </div>
    </nav>

    <main class="eg-main">
        @* ---- The announcement: Isa is live ---- *@
        <section class="eg-isa" aria-labelledby="eg-isa-title">
            <div class="eg-confetti" aria-hidden="true">
                @for (var i = 0; i < 18; i++)
                {
                    <i style="--i: @i"></i>
                }
            </div>
            <div class="eg-isa__badge">
                <span class="eg-isa__ring"><Throbber Spinning="false" /></span>
            </div>
            <div class="eg-isa__text">
                <p class="eg-isa__tag"><span>New</span> Chapter announcement</p>
                <h2 id="eg-isa-title">Say hello to Isa, your chapter's new assistant! 👋</h2>
                <p>
                    Starting today, Isa is live and ready for <b>every Sakura Bay member</b>. Ask her about
                    running and getting involved in the chapter, any time of day. She answers from ISACA's
                    approved guidance and shows you exactly where each answer comes from. When a question
                    needs a real person, she'll pass it on and give you a reference number.
                </p>
                <div class="eg-isa__btns">
                    <a class="eg-btn eg-btn--isa" href="/">Ask Isa a question</a>
                    <a class="eg-btn eg-btn--link">What can Isa do?</a>
                </div>
            </div>
            <div class="eg-isa__chat" aria-hidden="true">
                <div class="eg-bubble eg-bubble--you">How many board meetings must a chapter hold each year?</div>
                <div class="eg-bubble eg-bubble--isa">
                    <b>Isa</b>
                    The chapter board should meet regularly throughout the year, with a minimum of four board meetings annually.
                    <span class="eg-bubble__src">President Guidebook · p. 7</span>
                </div>
            </div>
        </section>

        <div class="eg-grid">
            <div class="eg-col">
                @* ---- Latest discussions ---- *@
                <section class="eg-card" aria-labelledby="eg-disc">
                    <div class="eg-cardHead">
                        <h2 id="eg-disc">Latest discussions</h2>
                        <a class="eg-more">View all</a>
                    </div>
                    <ul class="eg-posts">
                        @foreach (var p in Posts)
                        {
                            <li class="eg-post">
                                <span class="eg-avatar eg-avatar--sm" style="background: @p.Color">@p.Initials</span>
                                <div class="eg-post__body">
                                    <a class="eg-post__title">@p.Title</a>
                                    @if (p.Tag is not null)
                                    {
                                        <span class="eg-pill">@p.Tag</span>
                                    }
                                    <p class="eg-post__excerpt">@p.Excerpt</p>
                                    <p class="eg-post__meta"><b>@p.Author</b> · @p.Role · @p.When</p>
                                </div>
                                <span class="eg-post__replies" title="Replies"><b>@p.Replies</b> replies</span>
                            </li>
                        }
                    </ul>
                </section>

                @* ---- Library ---- *@
                <section class="eg-card" aria-labelledby="eg-lib">
                    <div class="eg-cardHead">
                        <h2 id="eg-lib">Recently added to the library</h2>
                        <a class="eg-more">Open library</a>
                    </div>
                    <ul class="eg-files">
                        @foreach (var (kind, name, meta, color) in Files)
                        {
                            <li>
                                <span class="eg-file" style="--c: @color">@kind</span>
                                <span><b>@name</b><small>@meta</small></span>
                            </li>
                        }
                    </ul>
                </section>
            </div>

            <aside class="eg-col eg-col--side" aria-label="Events and people">
                <section class="eg-card" aria-labelledby="eg-ev">
                    <div class="eg-cardHead">
                        <h2 id="eg-ev">Upcoming events</h2>
                        <a class="eg-more">Calendar</a>
                    </div>
                    <ul class="eg-events">
                        @foreach (var e in Events)
                        {
                            <li>
                                <span class="eg-date"><small>@e.Month</small><b>@e.Day</b></span>
                                <span>
                                    <b>@e.Title</b>
                                    <small>@e.When</small>
                                    @if (e.Cpe is not null)
                                    {
                                        <span class="eg-pill eg-pill--green">@e.Cpe</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                </section>

                <section class="eg-card" aria-labelledby="eg-lead">
                    <h2 id="eg-lead">Chapter leaders</h2>
                    <ul class="eg-people">
                        @foreach (var (initials, name, role, color) in Leaders)
                        {
                            <li>
                                <span class="eg-avatar eg-avatar--sm" style="background: @color">@initials</span>
                                <span><b>@name</b><small>@role</small></span>
                            </li>
                        }
                    </ul>
                </section>

                <section class="eg-card eg-stats" aria-label="Community at a glance">
                    <div><b>412</b><small>Members</small></div>
                    <div><b>38</b><small>Discussions this month</small></div>
                    <div><b>126</b><small>CPE hours earned this year</small></div>
                </section>
            </aside>
        </div>
    </main>

    <footer class="eg-foot">
        <span>Engage · sample page made for the Isa prototype</span>
        <span>Every person, post, event and number on this page is invented</span>
    </footer>
</div>

@code {
    private record Post(string Initials, string Color, string Title, string? Tag, string Excerpt, string Author, string Role, string When, int Replies);
    private record Ev(string Month, string Day, string Title, string When, string? Cpe);

    // Invented posts. The authors are the prototype's sample Sakura Bay board, plus one invented member.
    private static readonly Post[] Posts =
    {
        new("LJ", "#1b7a66", "Has anyone tried Isa yet? Share your favorite question", "Isa",
            "I asked how to plan our member welcome calls and got an answer with the page it came from. What have you asked?",
            "Lee Ji-woo", "Membership Director", "4 hours ago", 12),
        new("TM", "#3f7d20", "Speakers wanted for our September CPE evening", null,
            "We're looking for two speakers on cloud audit or privacy engineering. Talks are 30 minutes and earn speaker CPE.",
            "Takahashi Mei", "Vice President", "Yesterday", 8),
        new("MH", "#6b2f8f", "CISA study group starting in August", null,
            "Six weekly sessions, online on Thursday evenings. Reply here if you'd like to join, and say which domains you find hardest.",
            "Mori Haruka", "Member", "2 days ago", 15),
        new("NH", "#b0500f", "Photos from our June networking night", null,
            "Thank you to everyone who came to the bayside networking night! Photos are now in the library.",
            "Nakamura Hiroshi", "Secretary", "3 days ago", 6),
        new("WK", "#017dc2", "Volunteers needed to help plan the annual general meeting", null,
            "We're forming a small team to plan this year's AGM. A few hours a month, and a great way to meet the board.",
