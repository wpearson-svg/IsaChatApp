        ("PDF", "June board meeting minutes (approved)", "Added by Nakamura Hiroshi · 1 July", "#b0500f"),
        ("PPT", "Slides: Zero trust in plain words", "From the June CPE evening · 28 June", "#017dc2"),
        ("XLS", "Chapter calendar 2026-27", "Added by Watanabe Kenji · 2 July", "#3f7d20"),
    };

    private static readonly (string Initials, string Name, string Role, string Color)[] Leaders =
    {
        ("WK", "Watanabe Kenji", "President", "#017dc2"),
        ("TM", "Takahashi Mei", "Vice President", "#3f7d20"),
        ("NH", "Nakamura Hiroshi", "Secretary", "#b0500f"),
        ("DO", "Daniel Okafor", "Treasurer", "#6b2f8f"),
        ("LJ", "Lee Ji-woo", "Membership Director", "#1b7a66"),
