                    @FileList(Files.Take(3))
                </section>
            </div>

            <aside class="eg-col eg-col--side" aria-label="Events and people">
                <section class="eg-card" aria-labelledby="eg-ev">
                    <div class="eg-cardHead">
                        <h2 id="eg-ev">Upcoming events</h2>
                        <button type="button" class="eg-more" @onclick="@(() => Go("events"))">Calendar</button>
                    </div>
                    @EventList(Events.Where(e => !e.Past).Take(3), compact: true)
                </section>

                <section class="eg-card" aria-labelledby="eg-lead">
                    <div class="eg-cardHead">
                        <h2 id="eg-lead">Chapter leaders</h2>
                        <button type="button" class="eg-more" @onclick="@(() => Go("members"))">All members</button>
                    </div>
                    <ul class="eg-people">
                        @foreach (var m in Members.Where(m => m.Leader && m.Role != "Immediate Past President"))
                        {
                            <li>
                                <span class="eg-avatar eg-avatar--sm" style="background: @m.Color">@m.Initials</span>
                                <span><b>@m.Name</b><small>@m.Role</small></span>
                            </li>
                        }
                    </ul>
                </section>

                <section class="eg-card eg-stats" aria-label="Community at a glance">
                    <div><b>@MemberCount</b><small>Members</small></div>
                    <div><b>@(31 + _posts.Count)</b><small>Discussions this month</small></div>
                    <div><b>126</b><small>CPE hours earned this year</small></div>
                </section>
            </aside>
        </div>
    </text>;

    // =====================================================================
    // Discussions
    // =====================================================================

    private string _filter = "All";
    private string _search = "";
    private string _topSearch = "";
    private bool _composing;
    private string _newTitle = "";
    private string _newBody = "";
    private string _newTag = "General";

    private static readonly string[] Tags = { "Isa", "Events", "Study group", "Volunteering", "Photos" };

    private void StartPost()
    {
        _composing = true;
        Go("discussion");
    }

    private void SearchEngage()
    {
        _search = _topSearch.Trim();
        _filter = "All";
        Go("discussion");
    }

    private async Task Publish()
    {
        if (_newTitle.Trim().Length == 0) return;
        var post = new Post
        {
            Id = _nextPostId++, Initials = MyInitials, Color = MyColor, Title = _newTitle.Trim(),
            Tag = _newTag == "General" ? null : _newTag, Body = _newBody.Trim(),
            Author = Me, Role = MyRole, When = "Just now",
        };
        _posts.Insert(0, post);
        _composing = false;
        _newTitle = _newBody = "";
        _newTag = "General";
        await Toast("Posted for this demo only: nothing is saved or sent.");
    }

    private RenderFragment PostList(IEnumerable<Post> posts) => @<ul class="eg-posts">
        @foreach (var p in posts)
        {
            <li>
                <button type="button" class="eg-post" @onclick="@(() => Go("discussion", post: p.Id))">
                    <span class="eg-avatar eg-avatar--sm" style="background: @p.Color">@p.Initials</span>
                    <span class="eg-post__body">
                        <span class="eg-post__title">@p.Title</span>
                        @if (p.Tag is not null)
                        {
                            <span class="eg-pill">@p.Tag</span>
                        }
                        <span class="eg-post__excerpt">@p.Body</span>
                        <span class="eg-post__meta"><b>@p.Author</b> · @p.Role · @p.When</span>
                    </span>
                    <span class="eg-post__replies"><b>@p.ReplyCount</b> @(p.ReplyCount == 1 ? "reply" : "replies")</span>
                </button>
            </li>
        }
    </ul>;

    private RenderFragment DiscussionView()
    {
        var shown = _posts
            .Where(p => _filter == "All" || p.Tag == _filter)
            .Where(p => _search.Length == 0 || p.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                        || p.Body.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .ToList();
        return @<div class="eg-page">
            <div class="eg-pageHead">
                <h2>Discussion</h2>
                @if (!_composing)
                {
                    <button type="button" class="eg-btn eg-btn--isa" @onclick="@(() => _composing = true)">New discussion</button>
                }
            </div>

            @if (_composing)
            {
                <section class="eg-card eg-compose" aria-label="New discussion">
                    <label for="eg-new-title">Title</label>
                    <input id="eg-new-title" type="text" maxlength="120" placeholder="What would you like to talk about?" @bind="_newTitle" @bind:event="oninput" />
                    <label for="eg-new-body">Message</label>
                    <textarea id="eg-new-body" rows="4" maxlength="1000" placeholder="Write your message" @bind="_newBody" @bind:event="oninput"></textarea>
                    <div class="eg-compose__row">
                        <label class="eg-compose__tag">Topic
                            <select @bind="_newTag">
                                <option>General</option>
                                @foreach (var t in Tags)
                                {
                                    <option>@t</option>
                                }
                            </select>
                        </label>
                        <span class="eg-compose__btns">
                            <button type="button" class="eg-btn eg-btn--plain" @onclick="@(() => _composing = false)">Cancel</button>
                            <button type="button" class="eg-btn eg-btn--isa" disabled="@(_newTitle.Trim().Length == 0)" @onclick="Publish">Post</button>
                        </span>
                    </div>
                    <p class="eg-compose__note">Sample page: your post shows here until the page is reloaded. Nothing is saved or sent.</p>
                </section>
            }

            <div class="eg-toolbar">
                <label class="eg-filterSearch">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    <span class="eg-visually-hidden">Search discussions</span>
                    <input type="search" placeholder="Search discussions" @bind="_search" @bind:event="oninput" />
                </label>
                <div class="eg-chips" role="group" aria-label="Topic">
                    @foreach (var t in new[] { "All" }.Concat(Tags))
                    {
                        <button type="button" class="@(_filter == t ? "is-on" : "")" aria-pressed="@(_filter == t ? "true" : "false")"
                                @onclick="@(() => _filter = t)">@t</button>
                    }
                </div>
            </div>

            <section class="eg-card">
                @if (shown.Count == 0)
                {
                    <p class="eg-empty">No discussions match. Try another word or topic.</p>
                }
                else
                {
                    @PostList(shown)
                }
            </section>
        </div>;
    }

    // ---- One thread ----

    private string _replyText = "";

    private void ToggleLike(Post p)
    {
        p.LikedByMe = !p.LikedByMe;
        p.Likes += p.LikedByMe ? 1 : -1;
    }

    private async Task SendReply(Post p)
    {
        if (_replyText.Trim().Length == 0) return;
        p.Replies.Add(new Reply(MyInitials, MyColor, Me, MyRole, "Just now", _replyText.Trim()));
        _replyText = "";
        await Toast("Reply posted for this demo only: nothing is saved or sent.");
    }

    private RenderFragment ThreadView(Post p) => @<div class="eg-page">
        <nav class="eg-crumbs" aria-label="Breadcrumb">
            <button type="button" @onclick="@(() => Go("discussion"))">Discussion</button>
            <span aria-hidden="true">›</span>
            <span aria-current="page">@p.Title</span>
        </nav>

        <article class="eg-card eg-thread">
            <header class="eg-thread__head">
                <span class="eg-avatar" style="background: @p.Color">@p.Initials</span>
                <span><b>@p.Author</b><small>@p.Role · @p.When</small></span>
                @if (p.Tag is not null)
                {
                    <span class="eg-pill">@p.Tag</span>
                }
            </header>
            <h2>@p.Title</h2>
            @if (p.Body.Length > 0)
            {
                <p class="eg-thread__body">@p.Body</p>
            }
            <div class="eg-thread__actions">
                <button type="button" class="eg-like @(p.LikedByMe ? "is-on" : "")" aria-pressed="@(p.LikedByMe ? "true" : "false")" @onclick="@(() => ToggleLike(p))">
                    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M10 17s-6.5-4-6.5-8.5A3.5 3.5 0 0 1 10 6a3.5 3.5 0 0 1 6.5 2.5C16.5 13 10 17 10 17Z" fill="@(p.LikedByMe ? "currentColor" : "none")" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                    @p.Likes
                </button>
                <span>@p.ReplyCount @(p.ReplyCount == 1 ? "reply" : "replies")</span>
            </div>
        </article>

        <section class="eg-replies" aria-label="Replies">
            @if (p.EarlierReplies > 0)
            {
                <p class="eg-replies__earlier">@p.EarlierReplies earlier @(p.EarlierReplies == 1 ? "reply" : "replies")</p>
            }
            @foreach (var r in p.Replies)
            {
                <div class="eg-reply @(r.Author == Me ? "is-mine" : "")">
                    <span class="eg-avatar eg-avatar--sm" style="background: @r.Color">@r.Initials</span>
                    <div class="eg-reply__bubble">
                        <p class="eg-reply__who"><b>@r.Author</b> · @r.Role · @r.When</p>
                        <p>@r.Text</p>
                    </div>
                </div>
            }
        </section>

        <section class="eg-card eg-replyBox" aria-label="Reply">
            <label for="eg-reply-text">Reply as @Me</label>
            <textarea id="eg-reply-text" rows="3" maxlength="1000" placeholder="Write a reply" @bind="_replyText" @bind:event="oninput"></textarea>
            <div class="eg-compose__row">
                <span class="eg-compose__note">Sample page: nothing is saved or sent.</span>
                <button type="button" class="eg-btn eg-btn--isa" disabled="@(_replyText.Trim().Length == 0)" @onclick="@(() => SendReply(p))">Reply</button>
            </div>
        </section>
    </div>;

    // =====================================================================
    // Library
    // =====================================================================

    private string _folder = "All files";

    private Task OpenFile(LibFile f) =>
        Toast($"\"{f.Name}\" is a sample file name. Files aren't part of this prototype.");

    private RenderFragment FileList(IEnumerable<LibFile> files) => @<ul class="eg-files">
        @foreach (var f in files)
        {
            <li>
                <button type="button" @onclick="@(() => OpenFile(f))">
                    <span class="eg-file" style="--c: @f.Color">@f.Kind</span>
                    <span><b>@f.Name</b><small>@f.Meta</small></span>
                </button>
            </li>
        }
    </ul>;

    private RenderFragment LibraryView()
    {
        var folders = new[] { "All files" }.Concat(Files.Select(f => f.Folder).Distinct()).ToList();
        var shown = Files.Where(f => _folder == "All files" || f.Folder == _folder);
        return @<div class="eg-page">
            <div class="eg-pageHead"><h2>Library</h2></div>
            <div class="eg-libGrid">
                <nav class="eg-card eg-folders" aria-label="Folders">
                    @foreach (var name in folders)
                    {
                        var count = name == "All files" ? Files.Length : Files.Count(f => f.Folder == name);
                        <button type="button" class="@(_folder == name ? "is-on" : "")" aria-current="@(_folder == name ? "true" : null)"
                                @onclick="@(() => _folder = name)">
                            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M2.5 5.5a1 1 0 0 1 1-1h4l1.5 1.5h7.5a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                            <span>@name</span><small>@count</small>
                        </button>
                    }
                </nav>
                <section class="eg-card">
                    <h3 class="eg-libTitle">@_folder</h3>
                    @FileList(shown)
                </section>
            </div>
        </div>;
    }

    // =====================================================================
    // Events
    // =====================================================================

    private readonly HashSet<int> _registered = new();

    private async Task Register(Ev e)
    {
        if (!_registered.Add(e.Id)) { _registered.Remove(e.Id); await Toast("Registration cancelled (sample)."); return; }
        await Toast($"You're registered for \"{e.Title}\" (sample: nothing is saved or sent).");
    }

    private RenderFragment EventList(IEnumerable<Ev> events, bool compact) => @<ul class="eg-events @(compact ? "" : "eg-events--full")">
        @foreach (var e in events)
        {
            <li>
                <button type="button" @onclick="@(() => Go("events", ev: e.Id))">
                    <span class="eg-date"><small>@e.Month</small><b>@e.Day</b></span>
                    <span class="eg-events__text">
                        <b>@e.Title</b>
                        <small>@(compact ? e.When.Split(" · ")[0] + " · " + (e.Where.StartsWith("Online") ? "Online" : e.Where.Split(" · ")[0]) : $"{e.When} · {e.Where}")</small>
                        <span class="eg-events__tags">
                            @if (e.Cpe is not null)
                            {
                                <span class="eg-pill eg-pill--green">@e.Cpe</span>
                            }
                            @if (_registered.Contains(e.Id))
                            {
                                <span class="eg-pill eg-pill--blue">✓ Registered</span>
                            }
                        </span>
                    </span>
                </button>
            </li>
        }
    </ul>;

    private RenderFragment EventsView() => @<div class="eg-page">
        <div class="eg-pageHead"><h2>Events</h2></div>
        <section class="eg-card">
            <h3 class="eg-libTitle">Upcoming</h3>
            @EventList(Events.Where(e => !e.Past), compact: false)
        </section>
        <section class="eg-card">
            <h3 class="eg-libTitle">Past</h3>
            @EventList(Events.Where(e => e.Past), compact: false)
        </section>
    </div>;

    private RenderFragment EventView(Ev e) => @<div class="eg-page">
        <nav class="eg-crumbs" aria-label="Breadcrumb">
            <button type="button" @onclick="@(() => Go("events"))">Events</button>
            <span aria-hidden="true">›</span>
            <span aria-current="page">@e.Title</span>
        </nav>
        <article class="eg-card eg-event">
            <div class="eg-event__top">
                <span class="eg-date eg-date--lg"><small>@e.Month</small><b>@e.Day</b></span>
                <div>
                    <h2>@e.Title</h2>
                    <p class="eg-event__meta">@e.When</p>
                    <p class="eg-event__meta">@e.Where</p>
                    @if (e.Cpe is not null)
                    {
                        <span class="eg-pill eg-pill--green">@e.Cpe</span>
                    }
                </div>
            </div>
            <p class="eg-event__about">@e.About</p>
            <p class="eg-event__going">@(e.Going + (_registered.Contains(e.Id) ? 1 : 0)) @(e.Past ? "went" : "going")@(_registered.Contains(e.Id) ? ", including you" : "")</p>
            @if (!e.Past)
            {
                <div class="eg-event__btns">
                    <button type="button" class="eg-btn @(_registered.Contains(e.Id) ? "eg-btn--done" : "eg-btn--isa")" @onclick="@(() => Register(e))">
                        @(_registered.Contains(e.Id) ? "✓ Registered" : "Register")
                    </button>
                    <button type="button" class="eg-btn eg-btn--plain" @onclick="@(() => Toast("Calendar files aren't part of this prototype."))">Add to calendar</button>
                </div>
            }
            else
            {
                <button type="button" class="eg-btn eg-btn--plain" @onclick="@(() => Go("library"))">See the photos in the library</button>
            }
        </article>
    </div>;

    // =====================================================================
    // Members
    // =====================================================================

    private string _memberSearch = "";

    private RenderFragment MembersView()
    {
        var shown = Members.Where(m => _memberSearch.Length == 0
            || m.Name.Contains(_memberSearch, StringComparison.OrdinalIgnoreCase)
            || m.Role.Contains(_memberSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        return @<div class="eg-page">
            <div class="eg-pageHead">
                <h2>Members</h2>
                <span class="eg-pageHead__note">@MemberCount members · showing the @Members.Length who chose to be listed in the directory</span>
            </div>
            <div class="eg-toolbar">
                <label class="eg-filterSearch">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    <span class="eg-visually-hidden">Search members</span>
                    <input type="search" placeholder="Search by name or role" @bind="_memberSearch" @bind:event="oninput" />
                </label>
            </div>
            @if (shown.Count == 0)
            {
                <p class="eg-empty">No members match.</p>
            }
            <ul class="eg-members">
                @foreach (var m in shown)
                {
                    <li class="eg-card eg-member">
                        <span class="eg-avatar" style="background: @m.Color">@m.Initials</span>
                        <b>@m.Name</b>
                        <small>@m.Role</small>
                        <small class="eg-member__since">Member since @m.Since</small>
                        @if (m.Leader)
                        {
                            <span class="eg-pill eg-pill--blue">Chapter leader</span>
                        }
                    </li>
                }
            </ul>
        </div>;
    }
}
