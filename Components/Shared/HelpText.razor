@* ============================================================
   HelpText.razor

   One line of the "How to use Isa" guide (onboarding/help.json), with
   its small markup: **bold**, *italics*, and `TKT-0012` shown as a
   reference-number chip. Everything else is plain text, so nothing in
   the file is ever read as HTML. Used by HelpPanel.razor and the
   day-1 tour in TodayPanel.razor.
   ============================================================ *@

@foreach (var (kind, text) in Parts(Text))
{
    @if (kind == '*')
    {
        <strong>@text</strong>
    }
    else if (kind == '_')
    {
        <em>@text</em>
    }
    else if (kind == '`')
    {
        <span class="isa-helptext__ref">@text</span>
    }
    else
    {
        @text
    }
}

@code {
    [Parameter] public string? Text { get; set; }

    private static readonly System.Text.RegularExpressions.Regex Marks =
        new(@"\*\*(.+?)\*\*|\*(.+?)\*|`(.+?)`", System.Text.RegularExpressions.RegexOptions.Compiled);

    // Splits the line into (kind, text) pieces: '*' bold, '_' italics, '`' chip, ' ' plain.
    private static IEnumerable<(char, string)> Parts(string? text)
    {
        if (string.IsNullOrEmpty(text)) yield break;
        var at = 0;
        foreach (System.Text.RegularExpressions.Match m in Marks.Matches(text))
        {
            if (m.Index > at) yield return (' ', text[at..m.Index]);
            if (m.Groups[1].Success) yield return ('*', m.Groups[1].Value);
            else if (m.Groups[2].Success) yield return ('_', m.Groups[2].Value);
            else yield return ('`', m.Groups[3].Value);
            at = m.Index + m.Length;
        }
        if (at < text.Length) yield return (' ', text[at..]);
    }
}
