@* ============================================================
   JourneyCard.razor

   Onboarding feature, week 9 (see ONBOARDING-FEATURE.md, Feature 1).
   The slim "Your first 90 days" line at the top of the chat widget
   (Matthew's choice, 19 October 2026: the steps themselves live in
   the Today window, not here).

   What it shows: "Your first 90 days", the week and day of term, the
   role ("Chapter president"), and a thin progress bar through the 90
   days. Its Today and Notebook buttons moved to the rail on the left
   of the chat (IsaRail.razor, 21 October 2026); Matthew kept this line
   itself.

   Where the data comes from: JourneyContextService (who is signed in,
   their role and day of term). Nothing here comes from the AI model.
   The line shows nothing for anyone without a journey on today's date.
   ============================================================ *@

@using IsaChatApp.Services
@using IsaChatApp.Services.Onboarding
@inject JourneyContextService JourneyContexts

@if (_ctx is not null)
{
    <section class="isa-journey" aria-label="Your first 90 days">
        <div class="isa-journey__head">
            <span class="isa-journey__titles">
                <span class="isa-journey__title">Your first 90 days</span>
                @* The role sits in this line (not a separate badge) so the
                   strip stays one row and lines up with the Today window's
                   band beside it. *@
                <span class="isa-journey__when">Week @_ctx.Week &middot; Day @_ctx.Term.DayOfTerm &middot; @_ctx.BadgeText</span>
            </span>
        </div>

        <div class="isa-journey__bar" role="progressbar" aria-valuemin="0" aria-valuemax="90"
             aria-valuenow="@_ctx.Term.DayOfTerm" aria-label="Day @_ctx.Term.DayOfTerm of 90">
            <span class="isa-journey__barFill" style="width: @(_ctx.PercentThrough)%"></span>
        </div>
    </section>
}

@code {
    // Who is signed in, from the sign-in cookie.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private JourneyContext? _ctx;

    protected override async Task OnParametersSetAsync()
    {
        _ctx = null;
        if (AuthState is null) return;
        var user = (await AuthState).User;
        _ctx = JourneyContexts.GetFor(user.FindFirst(KeycloakSignInService.PersonIdClaim)?.Value);
    }
}
