@* ============================================================
   TodayPanel.razor

   Onboarding feature, week 9 (see ONBOARDING-FEATURE.md, Feature 1).
   The Today window: opens beside the chat when a leader clicks
   "Today" in the "Your first 90 days" strip. The chat widget slides
   the chat to the left to make room and slides it back when this
   window closes (ChatWidget.razor, IsTodayOpen).

   Four views, one at a time:
     1. Today's steps: a list of the leader's steps for today. Every
        step can be clicked. Completed steps show a check mark and the
        date. Opening a step never completes it. A "My progress" link
        sits under the list.
     4. My progress: all the steps of the 90 days, each marked done
        (with its date), not done yet, or coming up. Every step can be
        clicked from here too.
     2. The contact step ("Meet your Chapter Experience contact",
        J-03): Matthew's approved mockup. The sample contact's card,
        three ways to make contact (book a welcome call, send an
        introduction, join a group welcome), and the privacy line.
        Any one of the three completes the step.
     3. Any other step: its "What to do" text, its source if it comes
        from an ISACA document, and a "Mark as done" button. "Meet your
        board" (J-05) also lists the chapter's board (Matthew's approved
        mockup, Claude outputs/Meet your board mockups.html, 23 October
        2026): name, role, term dates, and each member's time zone with
        the time there now. No emails or contact details.
   Views 2 and 3 also show the step's history. Every "done" and "not
   done" is kept as its own entry (ProgressService.step_history), so
   the record is never rewritten. Dates are the leader's "today": the
   demo date while it is switched on.

   Where the data comes from (nothing here comes from the AI model):
     - JourneyContextService: who is signed in, role, day of term, steps.
     - ContactService: the chapter's invented sample contact, and the
       fake calendar (call times and group sessions worked out from the
       demo date).
     - ProgressService: what the leader has done (data/progress.db).
     - LeaderTermService.GetBoard: the chapter's board, from the team's
       directory (data/directory.db; invented people only).

   Prototype limits, stated on screen where they matter: the calendar is
   made up, and introductions are saved in Isa but never emailed.
   ============================================================ *@

@using System.Globalization
@using IsaChatApp.Services
@using IsaChatApp.Services.Onboarding
@inject JourneyContextService JourneyContexts
@inject ContactService Contacts
@inject ProgressService Progress
@inject LeaderTermService Terms
@inject HelpGuideService Guide
@inject LibraryService Library
@inject BoardIntroService BoardIntro
@inject KeycloakSignInService SignInService
@inject JourneyService Journey
@inject NotebookService Notebook
@inject IJSRuntime JS

<aside class="isa-today @(Rightmost ? "" : "is-inner")" style="@Style" aria-label="Today">

    @* Header band: ISACA Dark Blue, like the chat's header. *@
    <div class="isa-today__header">
        <div class="isa-today__headText">
            <span class="isa-today__name">Today</span>
            <span class="isa-today__date">@DateLabel</span>
        </div>
        <div class="isa-today__headBtns">
            @* Enlarge: widens this window to half the screen (the chat
               widget works out the sizes; see ChatWidget.razor). *@
            <button type="button" class="isa-today__iconBtn isa-today__enlarge" @onclick="OnToggleEnlarge"
                    aria-pressed="@(Enlarged ? "true" : "false")"
                    title="@(Enlarged ? "Make smaller" : "Enlarge")" aria-label="@(Enlarged ? "Make Today smaller" : "Enlarge Today")">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    @if (Enlarged)
                    {
                        <path d="M6.5 2.5v4h-4M9.5 13.5v-4h4M6.5 6.5L2 2M9.5 9.5L14 14" />
                    }
                    else
                    {
                        <path d="M10 2h4v4M6 14H2v-4M14 2L9 7M2 14l5-5" />
                    }
                </svg>
            </button>
            <button type="button" class="isa-today__close" @onclick="OnClose" aria-label="Close Today" title="Close Today">&times;</button>
        </div>
    </div>

    @if (_ctx is null)
    {
        <p class="isa-today__empty">Your first-90-days steps appear here when you are signed in as a chapter leader in the first 90 days of your term.</p>
    }
    else
    {
        @* Journey summary, as in the mockup: title, week and day, role
           badge, progress bar. Stays in view whichever step is open. *@
        <div class="isa-today__summary">
            <div class="isa-today__summaryRow">
                <span class="isa-today__summaryTitles">
                    <span class="isa-today__summaryTitle">Your first 90 days</span>
                    <span class="isa-today__summaryWhen">Week @_ctx.Week &middot; Day @_ctx.Term.DayOfTerm</span>
                </span>
                <span class="isa-today__badge">@_ctx.BadgeText</span>
            </div>
            <div class="isa-today__bar" role="progressbar" aria-valuemin="0" aria-valuemax="90"
                 aria-valuenow="@_ctx.Term.DayOfTerm" aria-label="Day @_ctx.Term.DayOfTerm of 90">
                <span class="isa-today__barFill" style="width: @(_ctx.PercentThrough)%"></span>
            </div>
        </div>

        @* Each screen (today's steps, My progress, a step) is drawn fresh
           when it changes (@key), so it starts at the top and glides in:
           from the right when going into a step or My progress, from the
           left when going back (Matthew asked, 20 October 2026: it used to
           just switch). The first screen doesn't glide, because the window
           itself is already sliding in. *@
        <div class="isa-today__body" @key="ViewKey">
          <div class="@ViewClass">

            @if (_selected is null && _showProgress)
            {
                @* ---- View 4: My progress, all 90 days ---- *@
                <button type="button" class="isa-today__back" @onclick="CloseProgress">&lsaquo; Today's steps</button>

                <h2 class="isa-today__stepHeading">My progress</h2>
                <p class="isa-today__lede">@DoneCount of @_ctx.AllSteps.Count steps done in your first 90 days.</p>

                <ul class="isa-today__steps">
                    @foreach (var step in _ctx.AllSteps)
                    {
                        var isDone = _done.ContainsKey(step.StepId);
                        var isToday = step.DayFrom <= _ctx.Term.DayOfTerm && step.DayTo >= _ctx.Term.DayOfTerm;
                        <li>
                            <button type="button" class="isa-today__step @(isDone ? "is-done" : "") @(isToday ? "is-today" : "")" @onclick="() => OpenStep(step, true)">
                                <span class="isa-today__check" aria-hidden="true"></span>
                                <span class="isa-today__stepText">
                                    <span class="isa-today__stepTitle">@step.Title</span>
                                    <span class="isa-today__stepSub">@DaysLabel(step) &middot; @StatusLabel(step)</span>
                                </span>
                                <span class="isa-today__arrow" aria-hidden="true"></span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (_selected is null && _showMonth)
            {
                @* ---- View 5: the month (November 6, 2026). Read only: journey
                   steps on the day they start, ISACA's key dates, the leader's
                   booked welcome call or group seat, and what the chapter's
                   notebook says for the same days last year. ---- *@
                <button type="button" class="isa-today__back" @onclick="CloseMonth">&lsaquo; Today's steps</button>

                <h2 class="isa-today__stepHeading">Calendar</h2>

                <div class="isa-cal__nav">
                    <button type="button" class="isa-cal__navBtn" @onclick="() => MoveMonth(-1)" disabled="@(!CanMoveMonth(-1))"
                            aria-label="Previous month">&lsaquo;</button>
                    <span class="isa-cal__month" aria-live="polite">@_month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</span>
                    <button type="button" class="isa-cal__navBtn" @onclick="() => MoveMonth(1)" disabled="@(!CanMoveMonth(1))"
                            aria-label="Next month">&rsaquo;</button>
                </div>

                <div class="isa-cal__grid" role="grid" aria-label="@_month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)">
                    @foreach (var wd in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                    {
                        <span class="isa-cal__wd" aria-hidden="true">@wd</span>
                    }
                    @for (var blank = 0; blank < (int)_month.DayOfWeek; blank++)
                    {
                        <span class="isa-cal__blank" aria-hidden="true"></span>
                    }
                    @for (var d = 1; d <= DateTime.DaysInMonth(_month.Year, _month.Month); d++)
                    {
                        var day = new DateOnly(_month.Year, _month.Month, d);
                        var info = DayInfo(day);
                        <button type="button"
                                class="isa-cal__day @(day == _ctx.Today ? "is-today" : "") @(day == _calSelected ? "is-selected" : "") @(info.InKeyDate ? "is-keydate" : "") @(info.InJourney ? "is-journey" : "")"
                                @onclick="() => _calSelected = day"
                                aria-pressed="@(day == _calSelected ? "true" : "false")"
                                aria-label="@CellLabel(day, info)">
                            <span class="isa-cal__num">@d</span>
                            <span class="isa-cal__dots" aria-hidden="true">
                                @if (info.StepsStarting.Count > 0) { <span class="isa-cal__dot is-step"></span> }
                                @if (info.KeyDateEdges.Count > 0) { <span class="isa-cal__dot is-key"></span> }
                                @if (info.Meetings.Count > 0) { <span class="isa-cal__dot is-call"></span> }
                                @if (info.LastYear.Count > 0) { <span class="isa-cal__dot is-past"></span> }
                            </span>
                        </button>
                    }
                </div>

                <ul class="isa-cal__legend" aria-label="What the marks mean">
                    <li><span class="isa-cal__dot is-step"></span> A journey step starts</li>
                    <li><span class="isa-cal__dot is-key"></span> ISACA key date</li>
                    <li><span class="isa-cal__dot is-call"></span> Your welcome call or session</li>
                    <li><span class="isa-cal__dot is-past"></span> Last year in the notebook</li>
                </ul>

                var sel = DayInfo(_calSelected);
                <section class="isa-cal__detail" aria-live="polite">
                    <h3 class="isa-cal__detailHead">
                        @_calSelected.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)
                        @if (sel.DayOfTerm is int dot)
                        {
                            <span>Day @dot of your term</span>
                        }
                    </h3>

                    @if (sel.StepsOnDay.Count == 0 && sel.KeyDatesOnDay.Count == 0 && sel.Meetings.Count == 0 && sel.LastYear.Count == 0)
                    {
                        <p class="isa-today__quiet">Nothing on this day.</p>
                    }

                    @if (sel.StepsOnDay.Count > 0)
                    {
                        <p class="isa-cal__group">Journey steps</p>
                        <ul class="isa-today__steps">
                            @foreach (var step in sel.StepsOnDay)
                            {
                                var isDone = _done.ContainsKey(step.StepId);
                                <li>
                                    <button type="button" class="isa-today__step @(isDone ? "is-done" : "")" @onclick="() => OpenStepFromMonth(step)">
                                        <span class="isa-today__check" aria-hidden="true"></span>
                                        <span class="isa-today__stepText">
                                            <span class="isa-today__stepTitle">@step.Title</span>
                                            <span class="isa-today__stepSub">@DaysLabel(step) &middot; @StatusLabel(step)</span>
                                        </span>
                                        <span class="isa-today__arrow" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="isa-cal__addBtn" @onclick="() => AddStep(step)" aria-label="@($"Add {step.Title} to my calendar")"><span class="isa-cal__addIcon" aria-hidden="true">+</span> Add to my calendar</button>
                                </li>
                            }
                        </ul>
                    }

                    @foreach (var k in sel.KeyDatesOnDay)
                    {
                        <p class="isa-cal__group">ISACA key date</p>
                        <p class="isa-cal__item" title="@k.Source">@KeyDateText(k, _calSelected)</p>
                        <p class="isa-cal__source">@k.Source</p>
                        <button type="button" class="isa-cal__addBtn" @onclick="() => AddKeyDate(k)" aria-label="@($"Add {k.Title} to my calendar")"><span class="isa-cal__addIcon" aria-hidden="true">+</span> Add to my calendar</button>
                    }

                    @foreach (var m in sel.Meetings)
                    {
                        <p class="isa-cal__group">You booked</p>
                        <p class="isa-cal__item">@m.Text</p>
                        <button type="button" class="isa-cal__addBtn" @onclick="() => AddMeeting(m)" aria-label="@($"Add {m.Title} to my calendar")"><span class="isa-cal__addIcon" aria-hidden="true">+</span> Add to my calendar</button>
                    }

                    @if (sel.LastYear.Count > 0)
                    {
                        <p class="isa-cal__group">This day last year, in your chapter's notebook</p>
                        @foreach (var e in sel.LastYear)
                        {
                            <blockquote class="isa-cal__past">
                                <span class="isa-cal__pastWho">@e.OnDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture) &middot; @e.AuthorName &middot; @e.KindLabel</span>
                                @e.Title
                            </blockquote>
                        }
                        <button type="button" class="isa-today__linkBtn" @onclick="OnOpenNotebook">Open the notebook</button>
                    }
                </section>

                <p class="isa-cal__note">
                    Dates come from your journey, ISACA's key dates and your chapter's notebook, never from the AI model.
                    Nothing here is sent anywhere.
                </p>
            }
            else if (_selected is null)
            {
                @* ---- View 1: today's steps ---- *@
                <h2 class="isa-today__sectionTitle">Today's steps</h2>

                @if (_ctx.TodaySteps.Count == 0)
                {
                    <p class="isa-today__quiet">
                        No new steps today.
                        @if (_ctx.NextStepDay is not null)
                        {
                            <span>Your next step starts on day @_ctx.NextStepDay.</span>
                        }
                    </p>
                }
                else
                {
                    <ul class="isa-today__steps">
                        @foreach (var step in _ctx.TodaySteps)
                        {
                            var isDone = _done.ContainsKey(step.StepId);
                            <li>
                                <button type="button" class="isa-today__step @(isDone ? "is-done" : "")" @onclick="() => OpenStep(step)">
                                    <span class="isa-today__check" aria-hidden="true"></span>
                                    <span class="isa-today__stepText">
                                        <span class="isa-today__stepTitle">@step.Title</span>
                                        <span class="isa-today__stepSub">@(isDone ? DoneLabel(_done[step.StepId]) : step.Details)</span>
                                    </span>
                                    <span class="isa-today__arrow" aria-hidden="true"></span>
                                </button>
                            </li>
                        }
                    </ul>
                }

                <button type="button" class="isa-today__progressLink" @onclick="OpenProgress">
                    <span>My progress <span class="isa-today__progressCount">&middot; @DoneCount of @_ctx.AllSteps.Count done</span></span>
                    <span class="isa-today__arrow" aria-hidden="true"></span>
                </button>

                <button type="button" class="isa-today__progressLink isa-today__calendarLink" @onclick="OpenMonth">
                    <span>Calendar <span class="isa-today__progressCount">&middot; the whole month</span></span>
                    <span class="isa-today__arrow" aria-hidden="true"></span>
                </button>
            }
            else if (_selected.StepId == JourneyContextService.ContactStepId)
            {
                @* ---- View 2: Meet your Chapter Experience contact (approved mockup) ---- *@
                <button type="button" class="isa-today__back" @onclick="Back">&lsaquo; @BackLabel</button>

                <h2 class="isa-today__stepHeading">@_selected.Title</h2>
                <p class="isa-today__lede">Your contact is the person to reach when Isa can't help, or when you'd rather talk to someone.</p>

                @if (_contact is null)
                {
                    <p class="isa-today__notice">No contact is set up for your chapter yet. (Developers: run python onboarding\build_onboarding_db.py.)</p>
                }
                else
                {
                    <div class="isa-today__contact">
                        <span class="isa-today__initials" aria-hidden="true">@_contact.Initials</span>
                        <span class="isa-today__contactText">
                            <span class="isa-today__contactName">@_contact.Name</span>
                            <span class="isa-today__contactTeam">@_contact.Team &middot; @_contact.RegionLabel</span>
                        </span>
                    </div>

                    @if (_contactHow is not null)
                    {
                        @* Step complete: say what was chosen. *@
                        <div class="isa-today__doneBox">
                            <div class="isa-today__doneTitle"><span class="isa-today__check is-on" aria-hidden="true"></span> @StepCompleteLabel(_selected)</div>
                            <p class="isa-today__doneText">@ContactDoneText</p>
                            @if (_contactHow == "introduction" && _myIntro is not null)
                            {
                                <blockquote class="isa-today__quote">@_myIntro</blockquote>
                            }
                            <button type="button" class="isa-today__linkBtn" @onclick="ChangeContactChoice">Change my choice</button>
                        </div>
                    }
                    else
                    {
                        @if (_notice is not null)
                        {
                            <p class="isa-today__notice" role="status">@_notice</p>
                        }

                        <div class="isa-today__options">

                            @* Option 1: book a welcome call. *@
                            <div class="isa-today__option">
                                <div class="isa-today__optionTitle">Book a welcome call</div>
                                <div class="isa-today__optionSub">Times shown in @_ctx.Term.TimeZone</div>
                                <div class="isa-today__slots">
                                    @foreach (var slot in _slots)
                                    {
                                        var key = ContactService.ToKey(slot);
                                        var takenByOther = _booked.TryGetValue(key, out var owner) && owner != _ctx.PersonId;
                                        <button type="button" class="isa-today__slot" disabled="@takenByOther" @onclick="() => BookCall(slot)">
                                            @ContactService.FormatInZone(slot, _ctx.Term.TimeZone)@(takenByOther ? " (taken)" : "")
                                        </button>
                                    }
                                </div>
                            </div>

                            @* Option 2: send an introduction. Spans the full width while writing,
                               and scrolls fully into view when it opens (see StartWriting). *@
                            <div class="isa-today__option @(_writing ? "is-wide" : "")" @ref="_introOption">
                                <div class="isa-today__optionTitle">Send an introduction</div>
                                <div class="isa-today__optionSub">A short hello by email, written your way.</div>
                                @if (!_writing)
                                {
                                    <button type="button" class="isa-today__optionBtn" @onclick="StartWriting">Write message</button>
                                }
                                else
                                {
                                    <label class="isa-today__label" for="isa-today-intro">To: @_contact.Name</label>
                                    <textarea id="isa-today-intro" class="isa-today__textarea" rows="7" @bind="_draft" @bind:event="oninput"></textarea>
                                    <p class="isa-today__hint">Prototype: your message is saved in Isa. Nothing is sent by email.</p>
                                    <div class="isa-today__btnRow">
                                        <button type="button" class="isa-today__optionBtn" disabled="@string.IsNullOrWhiteSpace(_draft)" @onclick="SendIntroduction">Send</button>
                                        <button type="button" class="isa-today__linkBtn" @onclick="CancelWriting">Cancel</button>
                                    </div>
                                }
                            </div>

                            @* Option 3: join a group welcome. *@
                            <div class="isa-today__option">
                                <div class="isa-today__optionTitle">Join a group welcome</div>
                                <div class="isa-today__optionSub">Meet other new presidents in your region.</div>
                                @if (!_showSession)
                                {
                                    <button type="button" class="isa-today__optionBtn" @onclick="ShowSession">See next session</button>
                                }
                                else
                                {
                                    <div class="isa-today__session">
                                        <span class="isa-today__sessionWhen">@ContactService.FormatInZone(_sessionUtc, _ctx.Term.TimeZone)</span>
                                        <span class="isa-today__sessionWhat">New presidents, @_contact.RegionLabel</span>
                                    </div>
                                    <button type="button" class="isa-today__optionBtn" @onclick="SaveSeat">Save my seat</button>
                                }
                            </div>
                        </div>
                    }

                    <p class="isa-today__privacy">
                        <svg class="isa-today__lock" viewBox="0 0 16 16" aria-hidden="true">
                            <rect x="3" y="7" width="10" height="7.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                            <path d="M5.5 7 V5 a2.5 2.5 0 0 1 5 0 V7" fill="none" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                        Your contact sees your chapter, role, and term dates. Your questions to Isa stay private.
                    </p>
                }

                <StepHistoryList Entries="_history" />
            }
            else
            {
                @* ---- View 3: any other step ---- *@
                <button type="button" class="isa-today__back" @onclick="Back">&lsaquo; @BackLabel</button>

                <h2 class="isa-today__stepHeading">@_selected.Title</h2>
                <p class="isa-today__when">@DaysLabel(_selected)</p>
                <p class="isa-today__lede">@_selected.Details</p>

                @if (JourneyContext.IsFromIsacaContent(_selected))
                {
                    <div class="isa-today__source">
                        <span class="isa-today__sourceIcon" aria-hidden="true"></span>
                        <span>@_selected.Source</span>
                    </div>
                }

                @* Listen (3 November 2026, onboarding/step_listen.json): one button for each
                   place the step cites. It opens the Library beside this window and reads
                   that part word for word. *@
                var listens = Library.GetStepListens(_selected.StepId);
                @if (listens.Count > 0)
                {
                    <div class="isa-today__listen">
                        <span class="isa-today__listenHead">Listen to the source</span>
                        @foreach (var l in listens)
                        {
                            <button type="button" class="isa-today__listenBtn" @onclick="() => Listen(l)"
                                    aria-label="@($"Listen to {l.Label}, about {MinutesLabel(l.Minutes)}")">
                                <span class="isa-today__listenIcon" aria-hidden="true">&#9654;</span>
                                <span class="isa-today__listenText">@l.Label</span>
                                <span class="isa-today__listenTime">about @MinutesLabel(l.Minutes)</span>
                            </button>
                        }
                    </div>
                }

                @if (_selected.StepId == TourStepId)
                {
                    @* "Get to know Isa": the day-1 tour, one card at a time
                       (onboarding/help.json). The last card opens the full guide. *@
                    var tour = Guide.Load().Tour;
                    if (tour.Count > 0)
                    {
                        var at = Math.Clamp(_tourIndex, 0, tour.Count - 1);
                        var card = tour[at];
                        <div class="isa-today__tour" aria-live="polite">
                            <div class="isa-today__tourDots" aria-label="@($"Card {at + 1} of {tour.Count}")">
                                @for (var d = 0; d < tour.Count; d++)
                                {
                                    <span class="@(d <= at ? "is-on" : "")"></span>
                                }
                            </div>
                            <p class="isa-today__tourTitle">@card.Title</p>
                            <p class="isa-today__tourText"><HelpText Text="@card.Text" /></p>
                            <div class="isa-today__tourBtns">
                                @if (at > 0)
                                {
                                    <button type="button" class="isa-today__tourBtn is-ghost" @onclick="() => _tourIndex = at - 1">Back</button>
                                }
                                @if (at < tour.Count - 1)
                                {
                                    <button type="button" class="isa-today__tourBtn" @onclick="() => _tourIndex = at + 1">Next</button>
                                }
                                else
                                {
                                    <button type="button" class="isa-today__tourBtn" @onclick="OnOpenHelp">Read the full guide</button>
                                }
                            </div>
                        </div>
                    }
                }

                @if (_selected.StepId == BoardStepId)
                {
                    @* "Meet your board": who is on the leader's chapter board. *@
                    var board = Terms.GetBoard(_ctx.Term.ChapterId, _ctx.Today);
                    <p class="isa-today__boardHead">
                        @_ctx.Term.ChapterName
                        <span>@(board.Count == 1 ? "1 board member" : $"{board.Count} board members")</span>
                    </p>
                    <ul class="isa-today__board">
                        @foreach (var m in board)
                        {
                            var isYou = m.PersonId == _ctx.PersonId;
                            var isPast = m.Role == "Immediate Past President";
                            var diff = TimeDifference(m.TimeZone, _ctx.Term.TimeZone);
                            <li class="isa-today__member">
                                <span class="isa-today__avatar @(isYou ? "is-you" : isPast ? "is-past" : "")" aria-hidden="true">@Initials(m.Name)</span>
                                <span class="isa-today__memberMain">
                                    <span class="isa-today__memberName">@m.Name@if (isYou) {<em> (you)</em>}</span>
                                    <span class="isa-today__memberRole">@m.Role@(isPast ? " · the president before you" : "")</span>
                                    <span class="isa-today__memberTerm">@TermLabel(m)</span>
                                </span>
                                <span class="isa-today__memberTime">
                                    <b>@LocalTime(m.TimeZone)</b>
                                    @City(m.TimeZone)
                                    @if (diff is not null)
                                    {
                                        <span class="isa-today__memberDiff">@diff</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                    <p class="isa-today__boardPrivacy">
                        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="10" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" /></svg>
                        From ISACA's records: names, board roles, term dates and time zones only.
                    </p>
                    var nextStep = _ctx.AllSteps.FirstOrDefault(s => s.StepId == BoardIntroStepId);
                    if (nextStep is not null)
                    {
                        <button type="button" class="isa-today__boardNext" @onclick="() => OpenStep(nextStep)">
                            <b>Next:</b> @nextStep.Title.ToLowerInvariant() &rsaquo;
                        </button>
                    }
                }

                @if (_selected.StepId == BoardIntroService.IntroStepId)
                {
                    @* "Introduce yourself to your board" (3 November 2026): a draft Isa
                       fills in from ISACA's records, which the president edits and saves.
                       Saved in Isa, never emailed. Saving it invites the board to the
                       optional profile form (Services/Onboarding/BoardIntroService.cs). *@
                    var intro = BoardIntro.GetIntroduction(_ctx.PersonId, _ctx.Term.ChapterId);
                    if (_writingBoard)
                    {
                        <label class="isa-today__label" for="isa-today-boardintro">To: your board</label>
                        <textarea id="isa-today-boardintro" class="isa-today__textarea isa-today__boardDraft" rows="11"
                                  @bind="_boardDraft" @bind:event="oninput" disabled="@_savingBoard"></textarea>
                        <p class="isa-today__hint">Change it any way you like. In this prototype it's saved in Isa; nothing is sent by email. When board members open Isa, they'll see your invitation to the optional profile form.</p>
                        <div class="isa-today__btnRow isa-today__boardBtns">
                            <button type="button" class="isa-today__primaryBtn" @onclick="SaveBoardIntro"
                                    disabled="@(_savingBoard || string.IsNullOrWhiteSpace(_boardDraft))">@(_savingBoard ? "Checking..." : "Save introduction")</button>
                            <button type="button" class="isa-today__linkBtn" @onclick="() => _writingBoard = false" disabled="@_savingBoard">Cancel</button>
                        </div>
                        @if (_boardProblem is not null)
                        {
                            <p class="isa-today__boardProblem" role="status">@_boardProblem</p>
                        }
                    }
                    else if (intro is not null)
                    {
                        <div class="isa-today__savedIntro">
                            <p class="isa-today__label">Your introduction, saved @FormatDate(intro.OnDate)</p>
                            <p class="isa-today__introText">@intro.Message</p>
                            <button type="button" class="isa-today__linkBtn" @onclick="StartBoardIntro">Edit</button>
                        </div>
                        <p class="isa-today__hint">Saved in Isa; nothing is sent by email. Board members see your invitation to the optional profile form when they open Isa. Their replies appear in "See your board's profile replies".</p>
                    }
                    else
                    {
                        <button type="button" class="isa-today__notebookBtn" @onclick="StartBoardIntro">Write your introduction</button>
                    }
                }

                @if (_selected.StepId == RepliesStepId)
                {
                    @* "See your board's profile replies": whatever has arrived so far.
                       Anyone who hasn't answered shows as "No reply yet": the president
                       never learns who said no, and Isa never chases anyone. *@
                    var replies = BoardIntro.GetReplies(_ctx.PersonId, _ctx.Today);
                    if (BoardIntro.GetIntroduction(_ctx.PersonId, _ctx.Term.ChapterId) is null)
                    {
                        var introStep = _ctx.AllSteps.FirstOrDefault(s => s.StepId == BoardIntroService.IntroStepId);
                        <p class="isa-today__hint">Your board sees the profile form once you've saved your introduction.</p>
                        @if (introStep is not null)
                        {
                            <button type="button" class="isa-today__boardNext" @onclick="() => OpenStep(introStep)">
                                <b>First:</b> @introStep.Title.ToLowerInvariant() &rsaquo;
                            </button>
                        }
                    }
                    <p class="isa-today__boardHead">
                        @_ctx.Term.ChapterName
                        <span>@replies.Count(r => r.Profile is not null) of @replies.Count replied</span>
                    </p>
                    <ul class="isa-today__board">
                        @foreach (var r in replies)
                        {
                            <li class="isa-today__member isa-today__reply">
                                <span class="isa-today__avatar" aria-hidden="true">@Initials(r.Member.Name)</span>
                                <span class="isa-today__memberMain">
                                    <span class="isa-today__memberName">@r.Member.Name</span>
                                    <span class="isa-today__memberRole">@r.Member.Role</span>
                                    @if (r.Profile is { } p)
                                    {
                                        <dl class="isa-today__answers">
                                            @if (p.GoodAt is not null) { <dt>Good at</dt><dd>@p.GoodAt</dd> }
                                            @if (p.Enjoy is not null) { <dt>Would enjoy</dt><dd>@p.Enjoy</dd> }
                                            @if (p.TimePerMonth is not null) { <dt>Time each month</dt><dd>@p.TimePerMonth</dd> }
                                            @if (p.ContactBy is not null) { <dt>Prefers</dt><dd>@p.ContactBy</dd> }
                                        </dl>
                                    }
                                    else
                                    {
                                        <span class="isa-today__noReply">No reply yet</span>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                    <p class="isa-today__boardPrivacy">
                        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="10" height="7" rx="1.5" /><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" /></svg>
                        Only you see these answers. Each member chose what to share, and can change or withdraw it.
                    </p>
                }

                @if (_selected.StepId == NotebookStepId)
                {
                    @* "Read what your predecessor left you": opens the
                       succession notebook beside this window. *@
                    <button type="button" class="isa-today__notebookBtn" @onclick="OnOpenNotebook">Open the notebook</button>
                }

                @if (_done.ContainsKey(_selected.StepId))
                {
                    <div class="isa-today__doneBox">
                        <div class="isa-today__doneTitle"><span class="isa-today__check is-on" aria-hidden="true"></span> @StepCompleteLabel(_selected)</div>
                        <button type="button" class="isa-today__linkBtn" @onclick="MarkNotDone">Mark as not done</button>
                    </div>
                }
                else
                {
                    <button type="button" class="isa-today__primaryBtn" @onclick="MarkDone">Mark as done</button>
                }

                <StepHistoryList Entries="_history" />
            }
          </div>
        </div>
    }
</aside>

@code {
    /// <summary>Called by the close button. The chat widget closes this window and slides the chat back.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Called by the Enlarge button. The chat widget widens this window to half the screen, or back.</summary>
    [Parameter] public EventCallback OnToggleEnlarge { get; set; }

    /// <summary>True while this window is enlarged (the button shows "Make smaller").</summary>
    [Parameter] public bool Enlarged { get; set; }

    /// <summary>Width and position, worked out by the chat widget so the panels sit side by side.</summary>
    [Parameter] public string Style { get; set; } = "";

    /// <summary>False when the notebook is open to its right, so all four corners round.</summary>
    [Parameter] public bool Rightmost { get; set; } = true;

    /// <summary>Called by "Open the notebook" on the "Read what your predecessor left you" step.</summary>
    [Parameter] public EventCallback OnOpenNotebook { get; set; }

    /// <summary>Called after a step is marked done or not done, so the rail's Today number updates.</summary>
    [Parameter] public EventCallback OnProgressChanged { get; set; }

    // After a step's progress changes: read this window again, then tell the chat widget.
    private async Task ProgressChanged()
    {
        Reload();
        await OnProgressChanged.InvokeAsync();
    }

    // The journey step that leads to the succession notebook.
    private const string NotebookStepId = "J-04";

    // ---- "Get to know Isa" (J-02): the day-1 tour ----
    private const string TourStepId = "J-02";
    private int _tourIndex;   // the card showing; back to the first each time the step opens

    /// <summary>"Read the full guide" at the end of the tour: the chat widget opens "How to use Isa".</summary>
    [Parameter] public EventCallback OnOpenHelp { get; set; }

    // ---- Listen on journey steps ----

    /// <summary>A step's Listen button: the chat widget opens the Library at that part and reads it.</summary>
    [Parameter] public EventCallback<ListenRequest> OnListen { get; set; }
    private int _listenPresses;

    private Task Listen(StepListen l) =>
        OnListen.InvokeAsync(new ListenRequest(l.Document, l.Pages, l.Label, ++_listenPresses));

    private static string MinutesLabel(int m) => m == 1 ? "1 minute" : $"{m} minutes";

    // ---- "Introduce yourself to your board" (J-19) and the replies (J-25) ----
    private const string RepliesStepId = "J-25";
    private bool _writingBoard;
    private string _boardDraft = "";
    private bool _savingBoard;
    private string? _boardProblem;
    private string? _sessionId;   // for the sign-in token the Input Compliance check needs

    // Opens the introduction: the saved one to edit, or Isa's draft from ISACA's records.
    private void StartBoardIntro()
    {
        if (_ctx is null) return;
        _boardDraft = BoardIntro.GetIntroduction(_ctx.PersonId, _ctx.Term.ChapterId)?.Message ?? BoardIntroService.Draft(_ctx.Term);
        _boardProblem = null;
        _writingBoard = true;
    }

    // Saves it after Isa's sign-in check and Input Compliance gate; saving completes J-19.
    private async Task SaveBoardIntro()
    {
        if (_ctx is null || _savingBoard) return;
        _savingBoard = true;
        _boardProblem = null;
        try
        {
            var token = await SignInService.GetAccessTokenAsync(_sessionId);
            _boardProblem = await BoardIntro.SaveIntroductionAsync(_ctx.PersonId, _ctx.Today, _boardDraft,
                token is null ? null : $"Bearer {token}");
            if (_boardProblem is null)
            {
                _writingBoard = false;
                await ProgressChanged();
            }
        }
        finally
        {
            _savingBoard = false;
        }
    }

    // ---- "Meet your board" (J-05) ----
    private const string BoardStepId = "J-05";
    private const string BoardIntroStepId = "J-19";   // "Introduce yourself to your board", the next step

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private static string TermLabel(BoardMember m) =>
        $"{m.TermStart.ToString("MMM yyyy", CultureInfo.InvariantCulture)} – {m.TermEnd.ToString("MMM yyyy", CultureInfo.InvariantCulture)}";

    // "Australia/Sydney" becomes "Sydney".
    private static string City(string timeZone) => timeZone.Split('/').Last().Replace('_', ' ');

    private static TimeZoneInfo? Zone(string id)
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById(id); }
        catch { return null; }
    }

    // The time it is now in that city (the real clock; only the day of term follows the demo date).
    private static string LocalTime(string timeZone)
    {
        var zone = Zone(timeZone);
        if (zone is null) return "";
        var t = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, zone);
        return t.ToString("h:mm tt", CultureInfo.InvariantCulture).ToLowerInvariant();
    }

    // "1 hour ahead of you", "2 hours 30 minutes behind you", or nothing when it's the same time.
    private static string? TimeDifference(string theirs, string yours)
    {
        var a = Zone(theirs);
        var b = Zone(yours);
        if (a is null || b is null) return null;
        var now = DateTime.UtcNow;
        var minutes = (int)(a.GetUtcOffset(now) - b.GetUtcOffset(now)).TotalMinutes;
        if (minutes == 0) return null;
        var h = Math.Abs(minutes) / 60;
        var m = Math.Abs(minutes) % 60;
        var amount = (h > 0 ? (h == 1 ? "1 hour" : $"{h} hours") : "") + (h > 0 && m > 0 ? " " : "") + (m > 0 ? $"{m} minutes" : "");
        return $"{amount} {(minutes > 0 ? "ahead of" : "behind")} you";
    }

    // Who is signed in, from the sign-in cookie.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private JourneyContext? _ctx;

    // Steps this leader has completed: step ID mapped to how and when.
    private IReadOnlyDictionary<string, StepDone> _done = new Dictionary<string, StepDone>();

    // The step open in view 2 or 3; null shows a list (view 1 or 4).
    private JourneyStep? _selected;

    // True shows My progress (view 4) instead of today's steps (view 1).
    private bool _showProgress;

    // True when the open step was opened from My progress, so Back returns there.
    private bool _openedFromProgress;

    // The open step's history, oldest first.
    private IReadOnlyList<StepHistoryEntry> _history = Array.Empty<StepHistoryEntry>();

    // ---- Contact step state ----
    private ChapterContact? _contact;
    private IReadOnlyList<DateTime> _slots = Array.Empty<DateTime>();
    private IReadOnlyDictionary<string, string> _booked = new Dictionary<string, string>();
    private DateTime _sessionUtc;
    private string? _contactHow;     // how the contact step was completed, or null
    private string? _myCall;         // time key of this leader's booked call
    private string? _mySeat;         // time key of this leader's group seat
    private string? _myIntro;        // the introduction this leader wrote
    private bool _writing;           // the introduction box is open
    private string _draft = "";
    private bool _showSession;       // the group session details are showing
    private string? _notice;         // e.g. "That time was just taken"

    // e.g. "Friday 3 July 2026" (the demo date unless it is switched off).
    private string DateLabel => _ctx is null ? "" : _ctx.Today.ToString("dddd d MMMM yyyy", CultureInfo.InvariantCulture);

    protected override async Task OnParametersSetAsync()
    {
        _ctx = null;
        if (AuthState is null) return;
        var user = (await AuthState).User;
        _ctx = JourneyContexts.GetFor(user.FindFirst(KeycloakSignInService.PersonIdClaim)?.Value);
        _sessionId = user.FindFirst(KeycloakSignInService.SessionClaim)?.Value;
        Reload();
    }

    // Reads everything this window shows from the databases again.
    private void Reload()
    {
        if (_ctx is null) return;
        _done = Progress.GetCompletedSteps(_ctx.PersonId);
        _history = _selected is null
            ? Array.Empty<StepHistoryEntry>()
            : Progress.GetHistory(_ctx.PersonId, _selected.StepId);

        _contact = Contacts.GetContactForChapter(_ctx.Term.ChapterId);
        if (_contact is null) return;

        _slots = Contacts.GetCallSlotsUtc(_contact, _ctx.Today);
        _sessionUtc = Contacts.GetGroupSessionUtc(_contact, _ctx.Today);
        _booked = Progress.GetBookedCalls(_contact.ContactId);
        _contactHow = _done.TryGetValue(JourneyContextService.ContactStepId, out var how) ? how.How : null;
        _myCall = Progress.GetMyCall(_ctx.PersonId);
        _mySeat = Progress.GetMySeat(_ctx.PersonId);
        _myIntro = Progress.GetMyIntroduction(_ctx.PersonId);
    }

    private void OpenStep(JourneyStep step) => OpenStep(step, false);

    // ---- View 5: the month (November 6, 2026) ----
    // Read only. Everything on it comes from the databases: journey steps
    // (placed by the term start date), ISACA's key dates, the leader's booked
    // call or seat, and the chapter notebook's entries from the same month a
    // year earlier (the notebook's own reading rules apply).

    private bool _showMonth;
    private bool _openedFromMonth;           // Back from a step returns to the month
    private DateOnly _month;                 // first day of the month showing
    private DateOnly _calSelected;           // the day whose details show under the grid
    private IReadOnlyList<NotebookEntry> _monthPast = Array.Empty<NotebookEntry>();
    private IReadOnlyList<KeyDateOnDay> _monthKeys = Array.Empty<KeyDateOnDay>();

    private void OpenMonth()
    {
        if (_ctx is null) return;
        _goingBack = false;
        _hasMoved = true;
        _selected = null;
        _showProgress = false;
        _showMonth = true;
        if (_month == default)
        {
            _month = new DateOnly(_ctx.Today.Year, _ctx.Today.Month, 1);
            _calSelected = _ctx.Today;
        }
        LoadMonth();
        Reload();
    }

    private void CloseMonth()
    {
        _goingBack = true;
        _hasMoved = true;
        _showMonth = false;
        Reload();
    }

    // The month can move from the term's first month to eleven months later (one term year).
    private DateOnly FirstMonth => _ctx is null ? _month : new DateOnly(_ctx.Term.TermStart.Year, _ctx.Term.TermStart.Month, 1);
    private bool CanMoveMonth(int by)
    {
        var to = _month.AddMonths(by);
        return to >= FirstMonth && to <= FirstMonth.AddMonths(11);
    }

    private void MoveMonth(int by)
    {
        if (!CanMoveMonth(by)) return;
        _month = _month.AddMonths(by);
        // Keep today selected in today's month; otherwise the 1st.
        _calSelected = _ctx is not null && _ctx.Today.Year == _month.Year && _ctx.Today.Month == _month.Month ? _ctx.Today : _month;
        LoadMonth();
    }

    private void LoadMonth()
    {
        if (_ctx is null) return;
        var last = _month.AddMonths(1).AddDays(-1);
        _monthPast = Notebook.GetFromPastYears(_ctx.PersonId, _ctx.Today, _month.AddYears(-1), last.AddYears(-1));
        _monthKeys = Journey.GetKeyDates(_month);   // each key date placed for the year this month is in
    }

    private void OpenStepFromMonth(JourneyStep step)
    {
        OpenStep(step, false);
        _openedFromMonth = true;
    }

    // Everything on one day of the month.
    private record CalDay(
        int? DayOfTerm, bool InJourney, bool InKeyDate,
        IReadOnlyList<JourneyStep> StepsStarting,      // dot: a step starts today
        IReadOnlyList<JourneyStep> StepsOnDay,         // details: every step meant for this day
        IReadOnlyList<KeyDateOnDay> KeyDateEdges,      // dot: a key date opens or closes
        IReadOnlyList<KeyDateOnDay> KeyDatesOnDay,     // details: any key date covering this day
        IReadOnlyList<CalMeeting> Meetings,
        IReadOnlyList<NotebookEntry> LastYear);

    // A booked welcome call or group seat: what the day's details say, and what goes in a calendar file.
    private record CalMeeting(string Key, string Title, string Text, DateTime StartUtc, int Minutes);

    // ---- "Add to my calendar" (November 6, 2026) ----
    // Makes a calendar file (Services/Onboarding/CalendarFile.cs) and hands it
    // to the leader's browser. Nothing is sent; opening the file adds the event
    // to the leader's own Outlook, Google or Apple calendar.

    private const string CalendarNote = "From Isa, your chapter support assistant. Open Isa for the details and the source.";

    private Task AddStep(JourneyStep step)
    {
        if (_ctx is null) return Task.CompletedTask;
        var first = _ctx.Term.TermStart.AddDays(step.DayFrom - 1);
        var last = _ctx.Term.TermStart.AddDays(step.DayTo - 1);
        var ics = CalendarFile.AllDay($"step-{step.StepId}-{_ctx.PersonId}", step.Title,
            $"Your first 90 days, {DaysLabel(step).ToLowerInvariant()}. {CalendarNote}", first, last);
        return Download(step.Title, ics);
    }

    private Task AddKeyDate(KeyDateOnDay k)
    {
        var ics = CalendarFile.AllDay($"key-{k.DateId}-{k.Starts:yyyy}", k.Title,
            $"Source: {k.Source}. {CalendarNote}", k.Starts, k.Ends);
        return Download(k.Title, ics);
    }

    private Task AddMeeting(CalMeeting m)
    {
        if (_ctx is null) return Task.CompletedTask;
        var ics = CalendarFile.Timed($"{m.Key}-{_ctx.PersonId}", m.Title, $"{m.Text}. {CalendarNote}", m.StartUtc, m.Minutes);
        return Download(m.Title, ics);
    }

    private async Task Download(string title, string ics)
    {
        try
        {
            _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/TodayPanel.razor.js");
            await _js.InvokeVoidAsync("downloadCalendarFile", CalendarFile.FileName(title), ics);
        }
        catch (JSDisconnectedException)
        {
            // The page went away; nothing to download.
        }
    }

    private CalDay DayInfo(DateOnly day)
    {
        if (_ctx is null) return new CalDay(null, false, false, [], [], [], [], [], []);
        var dot = day.DayNumber - _ctx.Term.TermStart.DayNumber + 1;
        int? dayOfTerm = dot >= 1 && day <= _ctx.Term.TermEnd ? dot : null;
        var inJourney = dot is >= 1 and <= 90;

        var starting = inJourney ? _ctx.AllSteps.Where(s => s.DayFrom == dot).ToList() : new List<JourneyStep>();
        var onDay = inJourney ? _ctx.AllSteps.Where(s => s.DayFrom <= dot && s.DayTo >= dot).ToList() : new List<JourneyStep>();

        var keys = _monthKeys.Where(k => day >= k.Starts && day <= k.Ends).ToList();
        var edges = keys.Where(k => day == k.Starts || day == k.Ends).ToList();

        // The prototype's fake calendar has no lengths: a call is taken as 30
        // minutes and the group welcome as an hour, for the calendar file only.
        var meetings = new List<CalMeeting>();
        var tz = _ctx.Term.TimeZone;
        if (_myCall is not null && LocalDay(ContactService.FromKey(_myCall), tz) == day)
        {
            var at = ContactService.FromKey(_myCall);
            meetings.Add(new CalMeeting("call", $"Welcome call with {_contact?.Name}",
                $"Welcome call with {_contact?.Name}, {ContactService.FormatInZone(at, tz)} ({tz})", at, 30));
        }
        if (_mySeat is not null && LocalDay(ContactService.FromKey(_mySeat), tz) == day)
        {
            var at = ContactService.FromKey(_mySeat);
            meetings.Add(new CalMeeting("group", "Group welcome for new presidents",
                $"Group welcome for new presidents, {ContactService.FormatInZone(at, tz)} ({tz})", at, 60));
        }

        // Same month and day a year earlier (February 29 shows on February 28).
        var past = _monthPast.Where(e => e.OnDate.Month == day.Month
            && Math.Min(e.OnDate.Day, DateTime.DaysInMonth(day.Year, day.Month)) == day.Day).ToList();

        return new CalDay(dayOfTerm, inJourney, keys.Count > 0, starting, onDay, edges, keys, meetings, past);
    }

    private static DateOnly LocalDay(DateTime utc, string timeZone)
    {
        var zone = Zone(timeZone);
        return DateOnly.FromDateTime(zone is null ? utc : TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), zone));
    }

    private static string KeyDateText(KeyDateOnDay k, DateOnly day)
    {
        string D(DateOnly x) => x.ToString("MMMM d", CultureInfo.InvariantCulture);
        if (day == k.Starts) return $"{k.Title} opens today. It runs until {D(k.Ends)}.";
        if (day == k.Ends) return $"{k.Title} closes today.";
        return $"{k.Title} is open ({D(k.Starts)} to {D(k.Ends)}).";
    }

    // What a screen reader hears for one day: the date and what is on it.
    private static string CellLabel(DateOnly day, CalDay info)
    {
        var parts = new List<string> { day.ToString("dddd, MMMM d", CultureInfo.InvariantCulture) };
        if (info.StepsStarting.Count > 0) parts.Add(info.StepsStarting.Count == 1 ? "1 step starts" : $"{info.StepsStarting.Count} steps start");
        if (info.KeyDateEdges.Count > 0) parts.Add("ISACA key date");
        if (info.Meetings.Count > 0) parts.Add("you booked a call or session");
        if (info.LastYear.Count > 0) parts.Add("a note from last year");
        return string.Join(", ", parts);
    }

    // Which screen is showing, so a new screen glides in when it changes,
    // and which way: back (from the left) or forward (from the right).
    private string ViewKey => _selected?.StepId ?? (_showProgress ? "progress" : _showMonth ? "month" : "today");
    private bool _goingBack;
    private bool _hasMoved;   // false until the first move inside the window
    private string ViewClass => !_hasMoved ? "" : _goingBack ? "isa-today__view isa-today__view--back" : "isa-today__view";

    private void OpenStep(JourneyStep step, bool fromProgress)
    {
        _tourIndex = 0;
        _goingBack = false;
        _hasMoved = true;
        _selected = step;
        _openedFromProgress = fromProgress;
        _openedFromMonth = false;
        _writing = false;
        _writingBoard = false;
        _boardProblem = null;
        _showSession = false;
        _notice = null;
        Reload();
    }

    // Back from a step: to My progress if it was opened there, otherwise to today's steps.
    private void Back()
    {
        _goingBack = true;
        _hasMoved = true;
        _selected = null;
        _showProgress = _openedFromProgress;
        _showMonth = _openedFromMonth;
        if (_showMonth) LoadMonth();
        Reload();
    }

    private string BackLabel => _openedFromMonth ? "Calendar" : _openedFromProgress ? "My progress" : "All of today's steps";

    private void OpenProgress()
    {
        _goingBack = false;
        _hasMoved = true;
        _selected = null;
        _showProgress = true;
        _showMonth = false;
        Reload();
    }

    private void CloseProgress()
    {
        _goingBack = true;
        _hasMoved = true;
        _showProgress = false;
        Reload();
    }

    // ---- Labels for the record ----

    private int DoneCount => _ctx is null ? 0 : _ctx.AllSteps.Count(s => _done.ContainsKey(s.StepId));

    // e.g. "Fri 3 July"
    public static string FormatDate(DateOnly date) => date.ToString("ddd d MMMM", CultureInfo.InvariantCulture);

    private static string DoneLabel(StepDone done) =>
        done.DoneOn is { } day ? $"Done on {FormatDate(day)}" : "Done";

    // "Step complete" heading, with the date when there is one.
    private string StepCompleteLabel(JourneyStep step) =>
        _done.TryGetValue(step.StepId, out var d) && d.DoneOn is { } day
            ? $"Step complete on {FormatDate(day)}"
            : "Step complete";

    // "Day 1" or "Days 2 to 3": when the step is meant for.
    private static string DaysLabel(JourneyStep step) =>
        step.DayFrom == step.DayTo ? $"Day {step.DayFrom}" : $"Days {step.DayFrom} to {step.DayTo}";

    // Status in My progress: done (with date), coming up, or not done yet.
    private string StatusLabel(JourneyStep step)
    {
        if (_done.TryGetValue(step.StepId, out var d)) return DoneLabel(d);
        if (_ctx is not null && step.DayFrom > _ctx.Term.DayOfTerm) return $"Coming up on day {step.DayFrom}";
        return "Not done yet";
    }

    // ---- Plain steps ----

    private async Task MarkDone()
    {
        if (_ctx is null || _selected is null) return;
        Progress.CompleteStep(_ctx.PersonId, _selected.StepId, "done", _ctx.Today);
        await ProgressChanged();
    }

    private async Task MarkNotDone()
    {
        if (_ctx is null || _selected is null) return;
        Progress.UndoStep(_ctx.PersonId, _selected.StepId, _ctx.Today);
        await ProgressChanged();
    }

    // ---- Contact step ----

    private async Task BookCall(DateTime slotUtc)
    {
        if (_ctx is null || _contact is null) return;
        if (!Progress.BookCall(_contact.ContactId, ContactService.ToKey(slotUtc), _ctx.PersonId))
        {
            _notice = "Sorry, someone else just booked that time. Please choose another.";
            Reload();
            return;
        }
        Progress.CompleteStep(_ctx.PersonId, JourneyContextService.ContactStepId, "call", _ctx.Today);
        _notice = null;
        await ProgressChanged();
    }

    private void StartWriting()
    {
        if (_ctx is null || _contact is null) return;
        var t = _ctx.Term;
        _draft =
            $"Hello {_contact.FirstName},\n\n" +
            $"I'm {t.Name}, the new {t.Role.ToLowerInvariant()} of the {t.ChapterName}. " +
            $"My term started on {t.TermStart.ToString("d MMMM yyyy", CultureInfo.InvariantCulture)}. " +
            "I'm looking forward to working with you.\n\n" +
            $"Best regards,\n{t.Name}";
        _writing = true;
        _revealIntro = true;
    }

    // Bring the open introduction form fully into view, so the leader
    // doesn't have to scroll to find it (Matthew, 22 October 2026).
    private ElementReference _introOption;
    private bool _revealIntro;
    private IJSObjectReference? _js;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_revealIntro) return;
        _revealIntro = false;
        try
        {
            _js ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/TodayPanel.razor.js");
            await _js.InvokeVoidAsync("revealElement", _introOption);
        }
        catch (JSDisconnectedException)
        {
            // The page went away; nothing to scroll.
        }
    }

    private void CancelWriting()
    {
        _writing = false;
        _draft = "";
    }

    private async Task SendIntroduction()
    {
        if (_ctx is null || _contact is null || string.IsNullOrWhiteSpace(_draft)) return;
        Progress.SaveIntroduction(_ctx.PersonId, _contact.ContactId, _draft.Trim());
        Progress.CompleteStep(_ctx.PersonId, JourneyContextService.ContactStepId, "introduction", _ctx.Today);
        _writing = false;
        _draft = "";
        await ProgressChanged();
    }

    private void ShowSession() => _showSession = true;

    private async Task SaveSeat()
    {
        if (_ctx is null || _contact is null) return;
        Progress.SaveSeat(_ctx.PersonId, ContactService.ToKey(_sessionUtc));
        Progress.CompleteStep(_ctx.PersonId, JourneyContextService.ContactStepId, "group", _ctx.Today);
        _showSession = false;
        await ProgressChanged();
    }

    private async Task ChangeContactChoice()
    {
        if (_ctx is null) return;
        Progress.ClearContactChoice(_ctx.PersonId, JourneyContextService.ContactStepId, _ctx.Today);
        _notice = null;
        await ProgressChanged();
    }

    // What the "Step complete" box says on the contact step.
    private string ContactDoneText
    {
        get
        {
            if (_ctx is null || _contact is null) return "";
            var tz = _ctx.Term.TimeZone;
            return _contactHow switch
            {
                "call" when _myCall is not null =>
                    $"Welcome call with {_contact.Name} booked for {ContactService.FormatInZone(ContactService.FromKey(_myCall), tz)} ({tz}).",
                "group" when _mySeat is not null =>
                    $"Seat saved at the group welcome for new presidents on {ContactService.FormatInZone(ContactService.FromKey(_mySeat), tz)} ({tz}).",
                "introduction" =>
                    $"Your introduction to {_contact.Name} is saved. In this prototype, nothing is sent by email.",
                _ => "You have made contact."
            };
        }
    }
}
