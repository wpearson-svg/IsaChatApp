// Keep your existing Blazor setup; ADD these lines.
// ============================================================

using IsaChatApp.Services;
using IsaChatApp.Services.Orchestrator;
using IsaChatApp.Services.Orchestrator.Stages;

var builder = WebApplication.CreateBuilder(args);

// --- existing Blazor services stay ---
builder.Services.AddRazorComponents()
    .AddInteractiveServerComponents();

// --- Foundation services (ADD) ---
builder.Services.AddHttpClient();
builder.Services.AddSingleton<EventLogService>();
builder.Services.AddSingleton<IAccessControlAdapter, KeycloakAccessControlAdapter>();
builder.Services.AddSingleton<AccessControlStage>();

builder.Services.AddSingleton<IEnumerable<IStage>>(sp => new IStage[]
{
    sp.GetRequiredService<AccessControlStage>(),
    new TranslationStage(),
    new InputComplianceStage(),
    new DatabaseSearchStage(sp.GetRequiredService<IConfiguration>()),
    new KnowledgeGraphStage(),
    new RagStage(),
    new ComplexAiStage(),
    new OutputComplianceStage(),
    new TicketingStage(),
});

builder.Services.AddSingleton<Orchestrator>();

var app = builder.Build();

// --- existing middleware stays ---
if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Error", createScopeForErrors: true);
    app.UseHsts();
}
app.UseHttpsRedirection();
app.UseAntiforgery();
app.MapStaticAssets();
app.MapRazorComponents<IsaChatApp.Components.App>()
    .AddInteractiveServerRenderMode();

// --- Foundation API (ADD) ---

app.MapPost("/api/ask", async (
    AskRequest req,
    HttpRequest http,
    Orchestrator orchestrator,
    AccessControlStage accessStage) =>
{
    var traceId = string.IsNullOrWhiteSpace(req.TraceId)
        ? Guid.NewGuid().ToString()
        : req.TraceId!;

    accessStage.IncomingToken = http.Headers.Authorization.FirstOrDefault();

    var ctx = new QueryContext
    {
        TraceId = traceId,
        Question = req.Question ?? "",
        Language = req.Language ?? "en",
    };

    var result = await orchestrator.RunAsync(ctx);
    return Results.Ok(result);
});

app.MapGet("/api/events/{traceId}", async (string traceId, EventLogService eventLog) =>
{
    var rows = await eventLog.GetByTraceIdAsync(traceId);
    return Results.Ok(rows);
});

app.Run();

public record AskRequest(string? Question, string? TraceId, string? Language);
