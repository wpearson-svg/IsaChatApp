<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- Leftover output folder from an earlier publish-based launch attempt.
         Excluded so MSBuild does not scan it as source content (it was
         causing BLAZOR106 build errors by picking up a stray copy of
         ReconnectModal.razor.js as if it were a new source file). Safe to
         delete this folder entirely; it is not used anymore. -->
    <Content Remove="publish/**" />
    <None Remove="publish/**" />
    <Compile Remove="publish/**" />
    <Watch Remove="publish/**" />
    <!-- The demo package (installer/build-package.ps1, November 17, 2026) publishes into installer/out:
         excluded for the same reason, so the package is never picked up as source. -->
    <Content Remove="installer/**" />
    <None Remove="installer/**" />
    <Compile Remove="installer/**" />
    <Watch Remove="installer/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

</Project>
