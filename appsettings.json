{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EventLog": { "Path": "data/events.db" },
  "ContentDb": { "Path": "data/content.db" },
  "DirectoryDb": { "Path": "data/directory.db" },
  "OnboardingDb": { "Path": "data/onboarding.db" },
  "ProgressDb": { "Path": "data/progress.db" },
  "NotebookDb": { "Path": "data/notebook.db" },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/isa",
    "AdditionalIssuers": [],
    "ClientId": "isa-web",
    "ClientSecret": ""
  },
  "AccessControl": { "DevBypass": false },
  "Ticketing": { "Salesforce": { "Enabled": true, "TimeoutSeconds": 10 } },
  "Tts": {
    "Enabled": true,
    "Endpoint": "http://localhost:8880",
    "Voice": "bf_lily",
    "Model": "kokoro",
    "PreGenerate": true,
    "WarmOnStart": true,
    "Pronunciations": { "ISACA": "Eyesocka" }
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434",
    "Model": "phi4-mini:3.8b",
    "TimeoutSeconds": 45,
    "NumPredict": 300,
    "KeepAlive": "60m",
    "IdleKeepAlive": "2m"
  },
  "Presentation": { "Mode": false },
  "Hhem": {
    "ModelPath": "data/models/hhem/model.onnx",
    "TokenizerPath": "data/models/hhem/spiece.model",
    "SelfTest": true
  },
  "Rules": { "Engine": true, "SelfTest": true },
  "AnswerWording": {
    "Enabled": true,
    "ExemptQuestions": [
      "How many board meetings must a chapter hold each year?",
      "Who writes down what the board decided?",
      "Where's a good pizza place near the conference?",
      "What is the cryptocurrency policy?",
      "A colleague keeps bothering me, what should I do?"
    ]
  }
}
